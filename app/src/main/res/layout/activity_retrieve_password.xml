<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_sumao_background"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.login.forgetPassword.RetrievePasswordActivity">

    <include
        android:id="@+id/title"
        layout="@layout/child_title_bar" />

    <RelativeLayout
        android:id="@+id/telephone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/white"
        android:padding="@dimen/x10">

        <TextView
            android:id="@+id/telephone_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x5"
            android:text="设置新密码"
            android:textSize="@dimen/x15" />

        <EditText
            android:id="@+id/telephone_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:layout_toRightOf="@id/telephone_tv"
            android:background="@null"
            android:hint="8-16个字符"
            android:singleLine="true"
            android:textSize="@dimen/x10" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/verification_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/telephone"
        android:layout_marginTop="@dimen/x2"
        android:background="@color/white"
        android:padding="@dimen/x10">

        <TextView
            android:id="@+id/verification_code_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x5"
            android:text="确认新密码"
            android:textSize="@dimen/x15" />

        <EditText
            android:id="@+id/verification_code_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:layout_toRightOf="@id/verification_code_tv"
            android:background="@null"
            android:hint="再次输入新密码"
            android:singleLine="true"
            android:textSize="@dimen/x10" />

    </RelativeLayout>

    <TextView
        android:id="@+id/prompt"
        android:text="两次输入的密码不一致"
        android:textColor="@color/red"
        android:layout_below="@id/verification_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x15"
        android:layout_marginTop="@dimen/x3"
        android:textSize="@dimen/x10" />

    <Button
        android:id="@+id/submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/verification_code"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:layout_marginTop="@dimen/x20"
        android:background="@drawable/button_background_blue"
        android:text="保存 "
        android:textColor="#fff" />
</RelativeLayout>
