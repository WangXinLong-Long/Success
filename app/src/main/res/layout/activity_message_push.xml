<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_type"
    tools:context=".fragments.myPlasticTrade.messagePush.view.MessagePushActivity">

    <RelativeLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:background="@color/zixun_topbg">
        <ImageView
            android:id="@+id/img_create_logistics_back"
            android:layout_width="@dimen/x60"
            android:layout_height="@dimen/x20"
            android:src="@mipmap/back"
            android:layout_marginRight="@dimen/x20"
            android:paddingLeft="@dimen/x10"
            android:background="@drawable/fanhui"
            android:paddingRight="@dimen/x15"
            android:layout_centerVertical="true"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="消息通知"
            android:layout_centerInParent="true"
            android:textColor="@color/selley_lv"
            android:textSize="18sp"
            />
        <ImageView
            android:id="@+id/img_create_logistics_search"
            android:layout_width="@dimen/x17"
            android:layout_height="@dimen/x17"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/x10"
            android:src="@mipmap/search"/>
    </RelativeLayout>

    <com.jingchen.pulltorefresh.PullToRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title"
        android:id="@+id/layoutPull"
        >

    <com.jingchen.pulltorefresh.PullableListView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/pullList"
        android:background="#fff"
        ></com.jingchen.pulltorefresh.PullableListView>

    </com.jingchen.pulltorefresh.PullToRefreshLayout>


</RelativeLayout>
