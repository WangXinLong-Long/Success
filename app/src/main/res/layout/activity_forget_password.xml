<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_sumao_background"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.login.forgetPassword.ForgetPasswordActivity">

    <include
        android:id="@+id/title"
        layout="@layout/child_title_bar" />

    <RelativeLayout
        android:id="@+id/retrieve_by_phone_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_marginTop="@dimen/x2"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/x10"
            android:text="通过手机号找回" />
    </RelativeLayout>
   <RelativeLayout
        android:id="@+id/retrieve_by_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/retrieve_by_phone_number"
        android:layout_marginTop="@dimen/x1"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/x10"
            android:text="通过邮箱找回" />
    </RelativeLayout>


</RelativeLayout>
