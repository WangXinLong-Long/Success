<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:id="@+id/order_layout_top"
        android:background="#28ABE3"
        >
        <ImageView
            android:id="@+id/ivBack_order_layout_top"
            android:layout_width="@dimen/x60"
            android:layout_height="@dimen/x20"
            android:src="@mipmap/back"
            android:layout_marginRight="@dimen/x20"
            android:paddingLeft="@dimen/x10"
            android:background="@drawable/fanhui"
            android:paddingRight="@dimen/x15"
            android:layout_centerVertical="true"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:textColor="#fff"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/y8"
            android:textSize="18sp"
            android:id="@+id/tv_title_name_order"
            />
        <ImageView
            android:layout_width="@dimen/x15"
            android:layout_height="@dimen/y14"
            android:id="@+id/ivSearch_order_layout_top"
            android:layout_marginTop="@dimen/y10"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:src="@drawable/search"
            />
    </RelativeLayout>
    <android.support.design.widget.TabLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/y25"
        android:id="@+id/seller_tab_layout"
        app:tabSelectedTextColor="#28ABE3"
        app:tabIndicatorColor="#28ABE3"
        android:layout_below="@+id/order_layout_top"
        ></android.support.design.widget.TabLayout>
    <android.support.v4.view.ViewPager
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/seller_tab_layout"
        android:id="@+id/seller_view_pager"
        ></android.support.v4.view.ViewPager>
</RelativeLayout>