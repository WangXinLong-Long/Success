<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#efefef"
    android:orientation="vertical"
    tools:context=".seller.fragmentone.account.SellerUpdatePasssActivity">
<include
    android:id="@+id/layout_updatepass_title"
    layout="@layout/seller_title_bar"></include>
 <!--   <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fff"
        android:layout_below="@+id/layout_updatepass_title"
        android:layout_marginTop="@dimen/x5"
        android:id="@+id/lv_update_pass"
        ></ListView>-->
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/gray"
        android:layout_height="@dimen/x40">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="#fff"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x5"
                android:textColor="@color/red"
                android:text="*"
                android:id="@+id/tv_xing_old"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/tv_xing_old"
                android:id="@+id/tvDemo_old"
                android:text="原密码"


                />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#fff"
            android:layout_marginLeft="@dimen/x1"
            >
            <ImageView
                android:layout_width="@dimen/x20"
                android:layout_height="@dimen/x20"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:layout_marginRight="@dimen/x10"
                android:id="@+id/iv_cancel_old"
                android:src="@mipmap/erroy"
                />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/iv_cancel_old"
                android:layout_centerVertical="true"
                android:id="@+id/ed_content_old"
                android:background="@null"
                android:password="true"
                />
        </RelativeLayout>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginTop="@dimen/x1"
        android:background="@color/gray"

        android:layout_height="@dimen/x40">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="#fff"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x5"
                android:textColor="@color/red"
                android:text="*"
                android:id="@+id/tv_xing"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/tv_xing"
                android:id="@+id/tvDemo"
                android:text="新密码"


                />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#fff"
            android:layout_marginLeft="@dimen/x1"
            >
            <ImageView
                android:layout_width="@dimen/x20"
                android:layout_height="@dimen/x20"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:layout_marginRight="@dimen/x10"
                android:id="@+id/iv_cancel"
                android:src="@mipmap/erroy"
                />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/iv_cancel"
                android:layout_centerVertical="true"
                android:id="@+id/ed_content"
                android:background="@null"
                android:password="true"
                />
        </RelativeLayout>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginTop="@dimen/x1"
        android:background="@color/gray"
        android:layout_height="@dimen/x40">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="#fff"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x5"
                android:textColor="@color/red"
                android:text="*"
                android:id="@+id/tv_xing_comfirm"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/tv_xing_comfirm"
                android:id="@+id/tvDemo_comfirm"
                android:text="确认密码"


                />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#fff"
            android:layout_marginLeft="@dimen/x1"
            >
            <ImageView
                android:layout_width="@dimen/x20"
                android:layout_height="@dimen/x20"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:layout_marginRight="@dimen/x10"
                android:id="@+id/iv_cancel_comfirm"
                android:src="@mipmap/erroy"
                />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/iv_cancel_comfirm"
                android:layout_centerVertical="true"
                android:id="@+id/ed_content_comfirm"
                android:background="@null"
                android:password="true"
                />
        </RelativeLayout>


    </LinearLayout>

</LinearLayout>
