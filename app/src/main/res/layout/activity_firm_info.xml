<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEF3"
    tools:context=".fragments.myPlasticTrade.companyInformations.firmInfomation.FirmInfoMVP.view.FirmInfoActivity">

    <include
        android:id="@+id/layoutTop_firm_info"
        layout="@layout/title_bar"></include>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layoutTop_firm_info"
        android:layout_marginTop="@dimen/x5"
        android:id="@+id/layout_info"
        android:background="#fff"
        >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/firm_info_title"
        android:layout_centerHorizontal="true"
        android:textColor="@color/common_top_bar_blue"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginRight="@dimen/x5"
        />
    </RelativeLayout>
    <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/lvShow_firm_info"
        android:layout_marginTop="@dimen/x1"
        android:layout_below="@+id/layout_info"
        ></ListView>

</RelativeLayout>
