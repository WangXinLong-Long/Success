<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.qurchaseQualification.purchaseQualificationDetail.ResultActivity">

    <include
        android:id="@id/title"
        layout="@layout/child_title_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/title">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/customer_application_rl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="@dimen/x5"
                android:background="@color/white">

                <TextView
                    android:id="@+id/customer_application_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:padding="@dimen/x7"
                    android:text="客户申请"
                    android:textColor="@color/orange" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/customer_application_rl"
                android:layout_marginTop="@dimen/x5"
                android:background="@color/white">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x70"
                    android:id="@+id/iv_jieguo"
                    android:padding="@dimen/x10" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_jieguo"
                    android:layout_marginLeft="@dimen/x40"
                    android:text="填写申请"
                    android:id="@+id/tv_tianxie"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_jieguo"
                    android:layout_toRightOf="@+id/tv_tianxie"
                    android:layout_marginLeft="@dimen/x40"
                    android:text="正在审核"
                    android:id="@+id/tv_shenhe"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_jieguo"
                    android:layout_toRightOf="@+id/tv_shenhe"
                    android:layout_marginLeft="@dimen/x40"
                    android:text="审核通过"
                    android:id="@+id/tv_Result"
                    />


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/enterprise_additional_information"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/state"
                android:layout_marginTop="@dimen/x5"
                android:background="@color/white">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"

                    android:id="@+id/ivResult"
                    />

           <!--     <TextView
                    android:id="@+id/enterprise_additional_information_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_marginTop="@dimen/x5"
                    android:text=""
                     />

                <TextView
                    android:id="@+id/split_line1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/enterprise_additional_information_tv"
                    android:layout_marginTop="@dimen/x7"
                    android:layout_centerHorizontal="true" />

                <TextView
                    android:id="@+id/split_line2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/split_line1"
                    android:layout_marginTop="@dimen/x7"
                    android:layout_centerHorizontal="true" />-->

        </RelativeLayout>
    </RelativeLayout>
    </ScrollView>
</RelativeLayout>
