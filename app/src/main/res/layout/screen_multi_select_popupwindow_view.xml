<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/layout_popup"
    android:background="#fff"
    android:layout_height="@dimen/x280"
    >
    <RelativeLayout
        android:layout_height="@dimen/x44"
        android:layout_width="match_parent"
        android:paddingTop="@dimen/padding_right"
        android:paddingBottom="@dimen/padding_right"
        android:background="@color/textColor_expandable_listview_show"
        android:id="@+id/title"
        >
        <ImageView
            android:id="@+id/iv_screen_title_bar_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x20"
            android:src="@mipmap/back"
            android:background="@drawable/fanhui"
            android:layout_marginRight="@dimen/x20"
            android:paddingLeft="@dimen/x10"
            android:paddingRight="@dimen/x15"
            android:layout_centerVertical="true"
            />
      <!--  <EditText
            android:layout_toRightOf="@id/iv_screen_title_bar_back"
            android:id="@+id/tv_screen_title_bar_title"
            android:layout_width="@dimen/x180"
            android:layout_height="@dimen/x50"
            android:text=""
            android:textSize="12sp"
            android:background="@drawable/button_background_white"
            android:hint="请输入牌号或其他信息"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            />-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#fff"
            android:layout_centerInParent="true"
            android:id="@+id/tv_Title"
            />
        <ImageView
            android:id="@+id/iv_screen_title_bar_search"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x20"
            android:paddingLeft="@dimen/x15"
            android:paddingRight="@dimen/x10"
            android:layout_centerVertical="true"
            android:src="@mipmap/search"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@id/layout_Bottom"
        android:background="#fff"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/x5"
        >
        <EditText
            android:layout_width="match_parent"
            android:layout_height="@dimen/x25"
            android:background="@drawable/juxing"
            android:id="@+id/et_productName"
            android:hint="请输入产品名称查询"
            android:layout_marginLeft="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:textColorHint="@color/gray_normal"
            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="@dimen/x25"
            android:background="@drawable/juxing"
            android:id="@+id/et_warehouseName"
            android:hint="请输入仓库名称查询"
            android:layout_below="@+id/et_productName"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginLeft="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:textColorHint="@color/gray_normal"
            />

        <RelativeLayout

            android:layout_width="match_parent"
            android:layout_height="@dimen/x50"
            android:layout_below="@id/et_warehouseName"
            >

            <Button
                android:id="@+id/reset"
                android:layout_width="@dimen/x50"
                android:layout_height="@dimen/x25"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x10"
                android:background="@drawable/button_background_yellow"
                android:text="重置" />

            <Button
                android:id="@+id/completed"
                android:layout_width="@dimen/x50"
                android:layout_height="@dimen/x25"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_backgroup_save"
                android:text="确定" />
        </RelativeLayout>
    </RelativeLayout>
    <ScrollView
        android:layout_below="@id/title"
        android:id="@+id/scroll_view"
        android:layout_above="@+id/layout_Bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x100">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/x100"
            android:background="@color/white"
            >
            <TextView
                android:id="@+id/region_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:text="地区" />

          <!--  <ImageView
                android:id="@+id/region_more_iv"
                android:layout_width="@dimen/x15"
                android:layout_height="@dimen/x10"
                android:layout_marginRight="@dimen/x10"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginTop="@dimen/x10"
                android:layout_alignParentRight="true"
                android:src="@drawable/more" />

            <TextView
                android:id="@+id/region_more_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/region_more_iv"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:text="更多" />-->

            <com.silianchuangye.sumao.success.custom.CustomGridView
                android:id="@+id/region_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/region_tv"
                android:horizontalSpacing="3dp"
                android:numColumns="5"
                android:layout_marginRight="@dimen/x5"
                android:layout_marginLeft="@dimen/x5"
                android:padding="@dimen/x5"
                android:verticalSpacing="3dp" />


            <TextView
                android:id="@+id/classification_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:layout_below="@id/region_grid"
                android:text="分类" />


          <!--  <ImageView
                android:id="@+id/classification_more_iv"
                android:layout_width="@dimen/x15"
                android:layout_height="@dimen/x10"
                android:layout_marginRight="@dimen/x10"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginTop="@dimen/x10"
                android:layout_alignParentRight="true"
                android:layout_below="@id/region_grid"
                android:src="@drawable/more" />

            <TextView
                android:id="@+id/classification_more_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/region_more_iv"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:layout_below="@id/region_grid"
                android:text="更多" />-->
            <com.silianchuangye.sumao.success.custom.CustomGridView
                android:layout_below="@id/classification_tv"
                android:id="@+id/classification_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="3dp"
                android:numColumns="5"
                android:padding="@dimen/x5"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginRight="@dimen/x5"
                android:verticalSpacing="3dp" />

            <TextView
                android:id="@+id/application_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:layout_below="@id/classification_grid"
                android:text="应用" />


          <!--  <ImageView
                android:id="@+id/application_more_iv"
                android:layout_width="@dimen/x15"
                android:layout_height="@dimen/x10"
                android:layout_marginRight="@dimen/x10"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginTop="@dimen/x10"
                android:layout_alignParentRight="true"
                android:layout_below="@id/classification_grid"
                android:src="@drawable/more" />

            <TextView
                android:id="@+id/application_more_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/region_more_iv"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:layout_below="@id/classification_grid"
                android:text="更多" />-->
            <com.silianchuangye.sumao.success.custom.CustomGridView
                android:layout_below="@id/application_tv"
                android:id="@+id/application_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="3dp"
                android:numColumns="5"
                android:layout_marginRight="@dimen/x5"
                android:layout_marginLeft="@dimen/x5"
                android:padding="@dimen/x5"
                android:verticalSpacing="3dp" />

            <TextView
                android:id="@+id/shengchanshang_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:layout_below="@id/application_grid"
                android:text="生产商" />
            <com.silianchuangye.sumao.success.custom.CustomGrideView
                android:layout_below="@id/shengchanshang_tv"
                android:id="@+id/shangchanshang_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="3dp"
                android:numColumns="5"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginRight="@dimen/x5"
                android:padding="@dimen/x5"
                android:verticalSpacing="3dp" />


        </RelativeLayout>
    </ScrollView>


</RelativeLayout>
