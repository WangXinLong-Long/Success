<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/login_background_picture"
    tools:context=".fragments.myPlasticTrade.login.LoginUserActivity">

    <TextView
        android:id="@+id/tv_title_bar_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:paddingLeft="30sp"
        android:paddingTop="7sp"
        android:text=""
        android:textSize="@dimen/x17" />

    <ImageView
        android:id="@+id/iv_title_bar_back"
        android:layout_width="40sp"
        android:layout_height="40sp"
        android:layout_alignParentLeft="true"
        android:clickable="true"
        android:src="@mipmap/back_black" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="15dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">


        <TextView
            android:id="@+id/tv_findpass_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"

            android:text="忘记密码"
            android:textColor="#B3B3B3" />

        <Button
            android:id="@+id/tv_register_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/tv_findpass_login"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:background="@drawable/button_back_white"
            android:text="快速注册"
            android:textColor="#0071BC" />

        <Button
            android:id="@+id/bt_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/tv_register_login"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:background="@drawable/button_back_deep_blue"
            android:text="立即登录"
            android:textColor="#fff" />

        <EditText
            android:id="@+id/checkout"
            android:layout_width="@dimen/x190"
            android:layout_height="wrap_content"
            android:layout_above="@id/bt_login"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:background="@drawable/login_background"
            android:hint="请输入验证码"
            android:layout_marginRight="@dimen/x15"
            android:paddingRight="50dp"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/verification_code"
            android:layout_width="wrap_content"
            android:layout_height="30sp"
            android:layout_above="@id/bt_login"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:layout_toRightOf="@id/checkout"

            />

        <EditText
            android:id="@+id/et_pass_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/verification_code"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:background="@drawable/login_background"
            android:hint="密码"
            android:text="Aa123456"
            android:inputType="textPassword"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_account_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/et_pass_login"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:background="@drawable/login_background"
            android:hint="帐号"
            android:text="hb0001"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/checkbox1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_above="@id/et_account_login"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:layout_marginLeft="50dp"
            android:background="@drawable/select_checkbox"
            android:button="@null"
            android:checked="true"
            android:visibility="gone"
            android:gravity="center" />

        <TextView
            android:id="@+id/buyer_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/et_account_login"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:layout_marginLeft="5dp"
            android:visibility="gone"
            android:layout_toRightOf="@id/checkbox1"
            android:text="买家登录"
            android:textColor="#1296DB"

            />


        <TextView
            android:id="@+id/seller_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/et_account_login"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:layout_marginRight="50dp"
            android:text="卖家登录"
            android:visibility="gone"
            android:textColor="#1296DB" />

        <CheckBox
            android:id="@+id/checkbox2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_above="@id/et_account_login"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:layout_toLeftOf="@id/seller_login"
            android:background="@drawable/select_checkbox"
            android:button="@null"
            android:visibility="gone"
            android:gravity="center" />

    </RelativeLayout>
</RelativeLayout>
