<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.accountmeneger.open.PinganFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EFEFEF"
        android:id="@+id/layout_open_no"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:layout_marginLeft="@dimen/x10"
            android:background="#fff"
            android:id="@+id/layout_jianshe"
            >
         <RelativeLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:id="@+id/layout_11"
             >
             <ImageView
                 android:layout_width="@dimen/x100"
                 android:layout_height="@dimen/x40"
                 android:layout_marginLeft="@dimen/x5"
                 android:layout_centerVertical="true"
                 android:id="@+id/iv_Bank_icon"
                 android:src="@mipmap/pingan_bank_no"
                 />
             <ImageView
                 android:layout_width="@dimen/x20"
                 android:layout_height="@dimen/x20"
                 android:layout_alignParentRight="true"
                 android:layout_centerVertical="true"
                 android:src="@mipmap/my_sumao_iv_order"
                 android:id="@+id/more"
                 />
             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_centerVertical="true"
                 android:layout_marginRight="@dimen/x3"
                 android:layout_toLeftOf="@+id/more"
                 android:textColor="@color/orange"
                 android:text="去开通"
                 android:id="@+id/tvOpen"
                 />
         </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/gray_normal"
                android:layout_marginTop="@dimen/x3"
                android:id="@+id/viewLine"
                android:layout_below="@+id/layout_11"
                android:layout_marginBottom="@dimen/x3"></View>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewLine"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简       介:"
                    android:layout_marginLeft="@dimen/x3"
                    android:id="@+id/jianjie_jianshe"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/jianjie_jianshe"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:id="@+id/tvConent"
                    android:text="企业使用平安银行开通塑贸网在线支付虚拟账户,用于购买平安银行结算的产品"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签约条件:"
                    android:layout_marginLeft="@dimen/x3"
                    android:layout_below="@id/tvConent"
                    android:id="@+id/jianjie_jianshe_tiaojian"
                    android:layout_marginTop="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvConent"
                    android:layout_toRightOf="@+id/jianjie_jianshe_tiaojian"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:layout_marginTop="@dimen/x5"
                    android:text="企业有平安银行一般结算账户"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签约方式:"
                    android:layout_marginTop="@dimen/x5"
                    android:layout_marginLeft="@dimen/x3"
                    android:layout_below="@id/jianjie_jianshe_tiaojian"
                    android:id="@+id/jianjie_jianshe_way"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/jianjie_jianshe_tiaojian"
                    android:layout_toRightOf="@+id/jianjie_jianshe_way"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:layout_marginTop="@dimen/x5"
                    android:text="企业U盾登录网银自主签约"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x5"
                    android:layout_marginBottom="@dimen/x5"
                    android:textColor="@color/my_sumao_title_background"
                    android:layout_marginRight="@dimen/x5"
                    android:layout_alignParentRight="true"
                    android:layout_below="@+id/jianjie_jianshe_way"
                    android:text="查看签约指南"
                    android:id="@+id/tvZhinan_pingan"
                    />
            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:layout_marginLeft="@dimen/x10"
            android:background="#fff"


            >
           <RelativeLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:id="@+id/layout_22"
               >
               <ImageView
                   android:layout_width="@dimen/x100"
                   android:layout_height="@dimen/x40"
                   android:layout_marginLeft="@dimen/x5"
                   android:layout_centerVertical="true"
                   android:id="@+id/iv_Bank_icon_qita"
                   android:src="@mipmap/qita_bank"
                   />
               <ImageView
                   android:layout_width="@dimen/x20"
                   android:layout_height="@dimen/x20"
                   android:layout_alignParentRight="true"
                   android:layout_centerVertical="true"
                   android:src="@mipmap/my_sumao_iv_order"
                   android:id="@+id/more_qita"
                   android:visibility="gone"
                   />
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_centerVertical="true"
                   android:layout_marginRight="@dimen/x3"
                   android:layout_toLeftOf="@+id/more_qita"
                   android:textColor="@color/orange"
                   android:text="去开通"
                   android:visibility="gone"
                   />
           </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/gray_normal"
                android:layout_marginTop="@dimen/x3"
                android:id="@+id/viewLine2"
                android:layout_below="@+id/layout_22"
                android:layout_marginBottom="@dimen/x3"></View>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewLine2"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简       介:"
                    android:layout_marginLeft="@dimen/x3"
                    android:id="@+id/jianjie_qita"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/jianjie_qita"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:id="@+id/tvConent1"
                    android:text="企业使用其他银行(包括建设银行和昆仑银行)办理平安银行电商管理功能,用于购买平安银行结算的产品"
                    />
            <!--    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签约条件:"
                    android:layout_marginLeft="@dimen/x3"
                    android:layout_below="@id/tvConent1"
                    android:id="@+id/jianjie_qita_tiaojian"
                    android:layout_marginTop="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvConent1"
                    android:layout_marginTop="@dimen/x5"
                    android:layout_toRightOf="@+id/jianjie_qita_tiaojian"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:text="其他银行一般结算账户"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签约方式:"
                    android:layout_marginLeft="@dimen/x3"
                    android:layout_below="@id/jianjie_qita_tiaojian"
                    android:id="@+id/jianjie_qita_way"
                    android:layout_marginTop="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/jianjie_qita_tiaojian"
                    android:layout_toRightOf="@+id/jianjie_qita_way"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:text="企业携带资料去建行任意柜台办理"
                    android:layout_marginTop="@dimen/x5"
                    />      -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x5"
                    android:layout_marginBottom="@dimen/x5"
                    android:textColor="@color/my_sumao_title_background"
                    android:layout_marginRight="@dimen/x5"
                    android:layout_alignParentRight="true"
                    android:layout_below="@+id/tvConent1"
                    android:text="查看签约指南"
                    android:id="@+id/tvzhinan_qita"
                    />
            </RelativeLayout>

        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EFEFEF"
        android:id="@+id/layout_open"
        android:orientation="vertical"
        android:visibility="gone"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:layout_marginLeft="@dimen/x10"
            android:background="#fff"
            android:id="@+id/layout_jianshe_open"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/layout_33"
                >
                <ImageView
                    android:layout_width="@dimen/x100"
                    android:layout_height="@dimen/x40"
                    android:layout_marginLeft="@dimen/x5"

                    android:id="@+id/iv_Bank_icon_open"
                    android:src="@mipmap/pingan_bank"
                    android:layout_centerVertical="true"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/x5"
                    android:layout_alignParentRight="true"
                    android:textColor="@color/my_sumao_title_background"
                    android:text="资金账户"
                    android:id="@+id/tvZijin"

                    />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/gray_normal"
                android:layout_marginTop="@dimen/x3"
                android:id="@+id/viewLine3"
                android:layout_below="@+id/layout_33"
                android:layout_marginBottom="@dimen/x3"></View>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewLine3"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账户名称:"
                    android:layout_marginLeft="@dimen/x3"
                    android:id="@+id/jianjie_jianshe_open"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/jianjie_jianshe_open"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:id="@+id/tvName"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开户银行:"
                    android:layout_marginTop="@dimen/x5"
                    android:layout_marginLeft="@dimen/x3"
                    android:layout_below="@id/jianjie_jianshe_open"
                    android:id="@+id/jianjie_jianshe_tiaojian_open"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/jianjie_jianshe_open"
                    android:layout_toRightOf="@+id/jianjie_jianshe_tiaojian_open"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:layout_marginTop="@dimen/x5"
                    android:id="@+id/tvBank"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="银行帐号:"
                    android:layout_marginTop="@dimen/x5"
                    android:layout_marginLeft="@dimen/x3"
                    android:layout_below="@id/tvBank"
                    android:id="@+id/jianjie_jianshe_account"
                    android:layout_marginBottom="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvBank"
                    android:layout_toRightOf="@+id/jianjie_jianshe_account"
                    android:layout_marginLeft="@dimen/x2"
                    android:layout_marginRight="@dimen/x5"
                    android:layout_marginTop="@dimen/x5"
                    android:id="@+id/tvBank_Account"
                    android:layout_marginBottom="@dimen/x5"
                    />
            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>


</FrameLayout>
