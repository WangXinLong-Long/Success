<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:layout_marginTop="0dp"
        android:id="@+id/layout_1"
        android:background="#29ABE2">

        <TextView
            android:id="@+id/tv_dialog_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:textColor="#fff"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/iv_dialog_ok_cancel"
            android:layout_width="@dimen/x18"
            android:layout_height="@dimen/x18"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x10"
            android:src="@mipmap/erroy" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fff"
        android:layout_below="@+id/layout_1"
        android:id="@+id/layout_2"
        >
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x10"
            android:layout_marginRight="@dimen/x10"
            android:layout_marginTop="@dimen/x5"
            android:background="@drawable/juxing"
            android:id="@+id/input"
            android:layout_marginBottom="@dimen/x5"
            />
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:background="@color/gray_normal"
        android:layout_below="@+id/layout_2"
        android:id="@+id/layout_3"
        ></View>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_below="@+id/layout_3"
        android:layout_height="wrap_content"
        android:id="@+id/layout_4"
        >
        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x25"
            android:layout_centerInParent="true"
            android:text="确定"
            android:textColor="#fff"
            android:id="@+id/btSure"
            android:layout_marginBottom="@dimen/x5"
            android:layout_marginTop="@dimen/x5"
            android:background="@color/textColor_expandable_listview_show"
            />
    </RelativeLayout>
</RelativeLayout>
