<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >

    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x43"
        android:layout_marginBottom="@dimen/x5"
        android:background="@color/my_sumao_title_background">

        <TextView
            android:id="@+id/information"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingBottom="@dimen/x5"
            android:paddingTop="@dimen/x5"
            android:text="资讯"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/image_view"
            android:layout_width="@dimen/x60"
            android:layout_height="@dimen/x20"
            android:src="@mipmap/back"
            android:layout_marginRight="@dimen/x20"
            android:paddingLeft="@dimen/x10"
            android:background="@drawable/fanhui"
            android:paddingRight="@dimen/x15"
            android:layout_centerVertical="true"
            android:visibility="visible"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/article_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title_bar"
        android:layout_centerVertical="true"
        android:text="标题"
        android:textSize="@dimen/x15" />

    <TextView
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/article_title"
        android:textColor="@color/black"
        android:textSize="@dimen/x10"
        android:text="时间" />

    <TextView
        android:id="@+id/from_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/time_text"
        android:textColor="@color/black"
        android:textSize="@dimen/x10"
        android:text="来源" />

    <!--浏览-->
    <TextView
        android:text="浏览"
        android:layout_below="@+id/time_text"
        android:id="@+id/browse_text"
        android:layout_toRightOf="@+id/from_text"
        android:layout_width="wrap_content"
        android:textColor="@color/black"
        android:textSize="@dimen/x10"
        android:layout_height="wrap_content" />
    <!--关注-->
    <ImageView
        android:id="@+id/browse_ima"
        android:layout_below="@+id/time_text"
        android:layout_toRightOf="@+id/browse_text"
        android:layout_width="@dimen/x10"
        android:layout_height="@dimen/x15"
        android:src="@mipmap/follow"
        />
    <TextView
        android:text="关注"
        android:textColor="@color/black"
        android:layout_toRightOf="@+id/browse_ima"
        android:layout_below="@+id/time_text"
        android:id="@+id/follow_text"
        android:textSize="@dimen/x10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <WebView
        android:layout_below="@id/follow_text"
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/x10"
        android:scrollbars="none"/>
</RelativeLayout>