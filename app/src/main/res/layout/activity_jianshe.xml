<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_type"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.accountmeneger.JiansheActivity">

    <include
        android:id="@+id/layout_title"
        layout="@layout/child_title_bar"></include>
    <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/lv_Jianshe"
        android:background="#fff"
        android:layout_marginTop="@dimen/x5"
        android:layout_below="@+id/layout_title"
        ></ListView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lv_Jianshe"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/x10"
        android:text="*如果使用其他银行注册E商贸通请选择其他银行"

        />

</RelativeLayout>
