<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/selley_lv"
    android:orientation="vertical"
    >
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/x10"
        android:background="@color/selley_bg"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40">
        <TextView
            android:id="@+id/tv_seeplan_bianhao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="需求编号:"
            android:layout_marginLeft="@dimen/x10"/>
        <TextView
            android:id="@+id/demand_or_order_number1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="sdf"
            android:layout_toRightOf="@id/tv_seeplan_bianhao"
            />
        <Button
            android:id="@+id/btn_seeplan_seeplan"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x25"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x10"
            android:text="查看原计划"
            android:visibility="gone"
            android:textColor="@color/selley_lv"
            android:background="@drawable/button_background_blue"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/selley_bg"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30">
        <TextView
            android:id="@+id/tv_seeplan_left_date1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="需求日期:"/>
        <TextView
            android:id="@+id/demand_date_num1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="2016-1-23"
            android:layout_toRightOf="@id/tv_seeplan_left_date1"/>
        <TextView
            android:id="@+id/tv_seeplan_left_name1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="提报日期: "
            android:layout_marginLeft="@dimen/x160"/>
        <TextView
            android:id="@+id/date_of_presentation_num1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/tv_seeplan_left_name1"
            android:text="dff"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30">
        <TextView
            android:id="@+id/tv_seeplan_left_date2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="分类: "/>
        <TextView
            android:id="@+id/classification_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="2016-1-23"
            android:layout_toRightOf="@id/tv_seeplan_left_date2"/>
        <TextView
            android:id="@+id/tv_seeplan_left_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="产品名称 : "
            android:layout_marginLeft="@dimen/x160"/>
        <TextView
            android:id="@+id/product_name_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/tv_seeplan_left_name"
            android:text="dff"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30">
        <TextView
            android:id="@+id/tv_seeplan_left_date23"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="价格 : "/>
        <TextView
            android:id="@+id/price_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"

            android:layout_toRightOf="@id/tv_seeplan_left_date23"/>
        <TextView
            android:id="@+id/tv_seeplan_left_name3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="数量:"
            android:layout_marginLeft="@dimen/x160"/>
        <TextView
            android:id="@+id/number_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/tv_seeplan_left_name3"
            android:text="dff"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30">
        <TextView
            android:id="@+id/tv_seeplan_left_peisong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="金额 : "/>
        <TextView
            android:id="@+id/amount_of_money_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"

            android:layout_toRightOf="@id/tv_seeplan_left_peisong"/>
        <TextView
            android:id="@+id/tv_seeplan_left_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="仓库 : "
            android:layout_marginLeft="@dimen/x160"/>
        <TextView
            android:id="@+id/warehouse_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/tv_seeplan_left_state"
            android:text="dff"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30">
        <TextView
            android:id="@+id/tv_seeplan_left_cangku1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="物流信息 : "/>
        <TextView
            android:id="@+id/logistics_information_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="2016-1-23"
            android:layout_toRightOf="@id/tv_seeplan_left_cangku1"/>
        <TextView
            android:id="@+id/tv_seeplan_left_num1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="卖家企业  : "
            android:layout_marginLeft="@dimen/x160"/>
        <TextView
            android:id="@+id/seller_enterprise_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/tv_seeplan_left_num1"
            android:text="dff"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30">
        <TextView
            android:id="@+id/tv_seeplan_left_peisong2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="类型 : "/>
        <TextView
            android:id="@+id/state_content1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="2016-1-23"
            android:layout_toRightOf="@id/tv_seeplan_left_peisong2"/>

    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/selley_bg"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40">
        <TextView
            android:id="@+id/tv_seeplan_left_dingdannum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:visibility="gone"
            android:layout_marginLeft="@dimen/x10"
            android:text="订单号 : "/>
        <TextView
            android:id="@+id/tv_seeplan_right_dingdannum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/tv_seeplan_left_dingdannum"
            android:text="2434234234"
            android:visibility="gone"
            android:layout_centerVertical="true"/>
        <Button
            android:id="@+id/copy_button1"
            android:layout_width="@dimen/x50"
            android:textColor="#59BEE9"
            android:layout_height="@dimen/x25"
            android:layout_centerVertical="true"
            android:text="复制"
            android:layout_marginRight="@dimen/x10"
            android:layout_alignParentRight="true"
            android:background="@drawable/text_corner"/>
    </RelativeLayout>

</LinearLayout>
