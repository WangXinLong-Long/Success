<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/demand_or_order1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="需求或订单："
        android:textSize="@dimen/x15"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginBottom="@dimen/x7"
        android:layout_marginTop="@dimen/x7"/>


    <TextView
        android:id="@+id/demand_or_order_number1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/x15"
        android:layout_toRightOf="@id/demand_or_order1"
        android:layout_marginBottom="@dimen/x7"
        android:layout_marginTop="@dimen/x7"/>
    <Button
        android:id="@+id/copy_button1"
        android:layout_width="@dimen/x36"
        android:layout_height="@dimen/x20"
        android:layout_marginRight="@dimen/x10"
        android:background="@drawable/text_corner"
        android:text="复制"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="@dimen/x7"
        android:layout_marginTop="@dimen/x7"
        android:textColor="#59BEE9"
        android:textSize="12sp"

        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:background="@color/gray_type"
        android:layout_below="@id/demand_or_order_number1"
        android:id="@+id/split_line11"
        android:layout_marginBottom="@dimen/x7"
        />
<!--需求-->
    <RelativeLayout
        android:id="@+id/demand1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/split_line11"
        android:paddingBottom="@dimen/x7"
        android:paddingLeft="@dimen/x7"
        android:paddingRight="@dimen/x7"
        >

        <TextView
            android:id="@+id/demand_date1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="需求日期:"
            android:layout_marginLeft="@dimen/x3"
            android:layout_marginBottom="@dimen/x7"/>
        <TextView
            android:id="@+id/demand_date_num1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/demand_date1"
            android:text="~~" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提报日期:"
            android:id="@+id/date_of_presentation1"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~~"
            android:id="@+id/date_of_presentation_num1"
            android:layout_toRightOf="@id/date_of_presentation1"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:background="@color/gray_type"
            android:layout_below="@id/demand_date1"
            />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="分类:"
        android:layout_marginLeft="@dimen/x10"
        android:id="@+id/classification1"
        android:layout_below="@id/demand1"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/classification_content1"
        android:layout_below="@id/demand1"
        android:layout_toRightOf="@id/classification1"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="产品名称:"
        android:id="@+id/product_name1"
        android:layout_below="@id/demand1"

        android:layout_centerHorizontal="true"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/product_name_content1"
        android:layout_below="@id/demand1"
        android:layout_toRightOf="@id/product_name1"
        android:text="~~"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="价格(元/吨):"
        android:id="@+id/price1"
        android:layout_marginLeft="@dimen/x10"
        android:layout_below="@id/classification1"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/price_content1"
        android:layout_below="@id/classification1"
        android:text="~~"
        android:layout_toRightOf="@id/price1"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="数量(吨):"
        android:id="@+id/number1"
        android:layout_below="@id/classification1"
        android:layout_centerHorizontal="true"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/number_content1"
        android:layout_below="@id/classification1"
        android:layout_toRightOf="@id/number1"
        android:text="~~"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="金额(元):"
        android:layout_marginLeft="@dimen/x10"
        android:id="@+id/amount_of_money1"
        android:layout_below="@id/price1"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/amount_of_money_content1"
        android:layout_below="@id/price1"
        android:text="~~"
        android:layout_toRightOf="@id/amount_of_money1"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="仓库:"
        android:id="@+id/warehouse1"
        android:layout_below="@id/price1"
        android:layout_alignLeft="@id/product_name1"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/warehouse_content1"
        android:layout_below="@id/price1"
        android:layout_toRightOf="@id/warehouse1"
        android:text="~~"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="物流信息:"
        android:layout_marginLeft="@dimen/x10"
        android:id="@+id/logistics_information1"
        android:layout_below="@id/amount_of_money1"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/logistics_information_content1"
        android:layout_below="@id/amount_of_money1"
        android:text="~~"
        android:layout_toRightOf="@id/logistics_information1"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="卖方企业:"
        android:id="@+id/seller_enterprise1"
        android:layout_below="@id/amount_of_money1"
        android:layout_centerHorizontal="true"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/seller_enterprise_content1"
        android:layout_below="@id/amount_of_money1"
        android:layout_toRightOf="@id/seller_enterprise1"
        android:text="~~"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="状态:"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginBottom="@dimen/x7"
        android:id="@+id/state1"
        android:layout_below="@id/logistics_information1"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/state_content1"
        android:layout_below="@id/logistics_information1"
        android:layout_toRightOf="@id/state1"
        android:text="~~"/>
    <RelativeLayout
        android:id="@+id/view_original_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_below="@id/state1"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:background="@color/gray_type"
            android:id="@+id/view_original_plan_split_line"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看原计划"
            android:textColor="@color/common_botton_bar_blue"
            android:layout_centerInParent="true"
            android:padding="@dimen/x7"
            android:layout_below="@id/view_original_plan_split_line"
            />
    </RelativeLayout>
</RelativeLayout>