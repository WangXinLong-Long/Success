<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F8F8"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/fragemnet_a"
                android:layout_width="match_parent"
                android:layout_height="@dimen/y100"
                android:background="@mipmap/spannerbackground">

                <com.silianchuangye.sumao.success.utils.scrollviewAD.MyGallery
                    android:id="@+id/fragment_gallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"></com.silianchuangye.sumao.success.utils.scrollviewAD.MyGallery>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/x15"
                android:layout_marginTop="@dimen/y88"
                android:gravity="right"
                android:orientation="horizontal"></LinearLayout>

            <GridView
                android:id="@+id/gvfragmentone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/fragemnet_a"
                android:horizontalSpacing="@dimen/x2"
                android:numColumns="5"
                android:verticalSpacing="@dimen/x2"></GridView>
            <!--地区-->
            <RelativeLayout
                android:padding="@dimen/x3"
                android:id="@+id/area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/gvfragmentone"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/x5"
                android:background="@color/white">

                <ImageView
                    android:id="@+id/area_img"
                    android:layout_width="@dimen/x20"
                    android:layout_height="@dimen/x20"
                    android:layout_marginBottom="@dimen/x3"
                    android:layout_marginLeft="@dimen/x5"
                    android:layout_marginTop="@dimen/x3"
                    android:src="@mipmap/area" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/area_img"
                    android:text="地区"
                    android:textColor="#0071BC"
                    android:layout_marginLeft="@dimen/x3"
                    android:textStyle="bold" />

            </RelativeLayout>

            <com.silianchuangye.sumao.success.custom.customCalendar.CustomGridView
                android:layout_centerInParent="true"

                android:layout_marginTop="@dimen/x2"
                android:id="@+id/area_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/area"
                android:horizontalSpacing="@dimen/x2"
                android:numColumns="5"
                android:verticalSpacing="@dimen/x2"></com.silianchuangye.sumao.success.custom.customCalendar.CustomGridView>
            <!--分类-->
            <RelativeLayout
                android:id="@+id/classification"
                android:padding="@dimen/x3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/area_detail"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/x5"
                android:background="@color/white">

                <ImageView
                    android:id="@+id/classification_img"
                    android:layout_width="@dimen/x20"
                    android:layout_height="@dimen/x20"
                    android:layout_marginBottom="@dimen/x3"
                    android:layout_marginLeft="@dimen/x5"
                    android:layout_marginTop="@dimen/x3"
                    android:src="@mipmap/classification" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/classification_img"
                    android:text="分类"
                    android:textColor="#8CC63F"
                    android:layout_marginLeft="@dimen/x3"
                    android:textStyle="bold" />
            </RelativeLayout>

            <com.silianchuangye.sumao.success.custom.customCalendar.CustomGridView
                android:layout_marginTop="@dimen/x2"
                android:id="@+id/classification_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/classification"
                android:horizontalSpacing="@dimen/x2"
                android:numColumns="5"
                android:verticalSpacing="@dimen/x2"></com.silianchuangye.sumao.success.custom.customCalendar.CustomGridView>
            <!--应用-->
            <RelativeLayout
                android:id="@+id/application"
                android:layout_width="match_parent"
                android:padding="@dimen/x3"
                android:layout_height="wrap_content"
                android:layout_below="@id/classification_detail"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/x5"
                android:background="@color/white">

                <ImageView
                    android:id="@+id/application_img"
                    android:layout_width="@dimen/x20"
                    android:layout_height="@dimen/x20"
                    android:layout_marginBottom="@dimen/x3"
                    android:layout_marginLeft="@dimen/x5"
                    android:layout_marginTop="@dimen/x3"
                    android:src="@mipmap/application" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/application_img"
                    android:text="应用"
                    android:textColor="#F7931E"
                    android:layout_marginLeft="@dimen/x3"
                    android:textStyle="bold" />
            </RelativeLayout>

            <com.silianchuangye.sumao.success.custom.customCalendar.CustomGridView
                android:layout_marginTop="@dimen/x2"
                android:id="@+id/application_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/application"
                android:horizontalSpacing="@dimen/x2"
                android:numColumns="5"
                android:verticalSpacing="@dimen/x2"></com.silianchuangye.sumao.success.custom.customCalendar.CustomGridView>


        </RelativeLayout>
    </ScrollView>
</LinearLayout>