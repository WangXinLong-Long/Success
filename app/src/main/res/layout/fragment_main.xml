<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    tools:context="com.silianchuangye.sumao.success.seller.MainFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <!--黑色的头-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x80"
                android:background="#333333"
                android:id="@+id/layout_main_title"
                >
                <ImageView
                    android:id="@+id/my_sumao_iv_icon"
                    android:layout_width="100sp"
                    android:layout_height="100sp"
                    android:src="@mipmap/my_sumao_icon"
                    android:layout_marginLeft="@dimen/x15"
                    android:layout_marginTop="@dimen/x15"
                    android:layout_marginBottom="@dimen/x15"
                    android:visibility="invisible"

                    />
                <TextView
                    android:id="@+id/my_sumao_tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="河北齐鑫塑化有限公司"
                    android:layout_toRightOf="@id/my_sumao_iv_icon"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="@dimen/x20"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/my_sumao_iv_icon"
                    android:layout_below="@+id/my_sumao_tv_name"
                    android:id="@+id/tvUsername"
                    android:layout_marginTop="@dimen/x10"
                    android:textColor="#fff"
                    android:textSize="14sp"
                    android:text="河北齐鑫"
                    />
                <ImageView
                    android:id="@+id/my_sumao_ib_setting"
                    android:layout_width="@dimen/x20"
                    android:layout_height="@dimen/x20"
                    android:layout_margin="@dimen/x10"
                    android:src="@mipmap/my_sumao_setting"
                    android:layout_alignParentRight="true"

                    />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_below="@+id/layout_main_title"
                android:layout_marginBottom="@dimen/x80"
                >
                <!--黄色的线-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x3"
                    android:background="#F7931E"
                    ></LinearLayout>
                <!--企业信息和账户信息-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x80"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    >
                    <!--企业信息-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#fff"
                        >
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:src="@mipmap/home_page_true"
                            android:id="@+id/iv_firm_info"
                            />
                    </RelativeLayout>
                    <!--账户信息-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#fff"
                        android:layout_marginLeft="@dimen/x1"
                        >
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:src="@mipmap/home_page_true"
                            android:id="@+id/iv_user_info"
                            />
                    </RelativeLayout>
                </LinearLayout>
                <!--产品管理-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_marginBottom="@dimen/x10"
                        android:layout_marginLeft="@dimen/x10"
                        android:text="产品管理"
                        />
                </LinearLayout>
                <!--产品管理下的6的内容-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x140"
                    android:orientation="horizontal"
                    android:weightSum="3"

                    >
                    <!--现货和需求计划-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:weightSum="2"
                        android:layout_weight="1"
                        >
                        <!--现货-->

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#fff"
                        >
                        <ImageView
                            android:layout_width="@dimen/x40"
                            android:layout_height="@dimen/x40"
                            android:layout_centerInParent="true"
                            android:id="@+id/xianhuo_icon"
                            android:src="@mipmap/home_page_true"
                            />
                    </RelativeLayout>
                        <!--需求计划-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#fff"
                       android:layout_marginTop="@dimen/x1"
                        >
                        <ImageView
                            android:layout_width="@dimen/x40"
                            android:layout_height="@dimen/x40"
                            android:layout_centerInParent="true"
                            android:id="@+id/xuqiu_icon"
                            android:src="@mipmap/home_page_true"
                            />
                    </RelativeLayout>
                    </LinearLayout>
                    <!--上架审批和在售产品-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:weightSum="2"
                        android:layout_weight="1"
                        android:layout_marginLeft="@dimen/x1"
                        >
                        <!--上架审批-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:id="@+id/layout_shepi"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/common_top_bar_blue"
                                android:textStyle="bold"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x10"
                                android:id="@+id/tv_shenpi_num"
                                android:text="21"
                                android:textSize="25sp"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="上架审批"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x5"
                                android:layout_below="@+id/tv_shenpi_num"
                                />
                        </RelativeLayout>
                        <!--在售产品-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:layout_marginTop="@dimen/x1"
                            >
                            <ImageView
                                android:layout_width="@dimen/x30"
                                android:layout_height="@dimen/x30"
                                android:layout_centerInParent="true"
                                android:src="@mipmap/help_check"
                                android:id="@+id/iv_zaishou"

                                />
                        </RelativeLayout>
                    </LinearLayout>
                    <!--申请产品待上架-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:weightSum="2"
                        android:layout_weight="1"
                        android:layout_marginLeft="@dimen/x1"
                        >
                        <!--申请产品-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#fff"
                            >
                            <ImageView
                                android:layout_width="@dimen/x30"
                                android:layout_height="@dimen/x30"
                                android:layout_centerInParent="true"
                                android:src="@mipmap/help_check"
                                android:id="@+id/iv_shenqing"

                                />
                        </RelativeLayout>
                        <!--待上架-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:layout_marginTop="@dimen/x1"
                            >
                            <ImageView
                                android:layout_width="@dimen/x30"
                                android:layout_height="@dimen/x30"
                                android:layout_centerInParent="true"
                                android:src="@mipmap/help_check"
                                android:id="@+id/iv_daishangjia"

                                />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
                <!--交易管理-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_marginBottom="@dimen/x10"
                        android:layout_marginLeft="@dimen/x10"
                        android:text="交易管理"
                        />
                </LinearLayout>
                <!--产品管理下的6的内容-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x140"
                    android:orientation="horizontal"
                    android:weightSum="3"

                    >
                    <!--全部订单和需求计划-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:weightSum="2"
                        android:layout_weight="1"
                        >
                        <!--全部订单-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#fff"

                            >
                            <ImageView
                                android:layout_width="@dimen/x40"
                                android:layout_height="@dimen/x40"
                                android:layout_centerInParent="true"
                                android:src="@mipmap/home_page_true"
                                android:id="@+id/iv_all_order"
                                />
                        </RelativeLayout>
                        <!--需求计划-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginTop="@dimen/x1"
                            android:background="#fff"
                            >
                            <ImageView
                                android:layout_width="@dimen/x40"
                                android:layout_height="@dimen/x40"
                                android:layout_centerInParent="true"
                                android:src="@mipmap/home_page_true"
                                android:id="@+id/iv_plan_xuqiu"
                                />
                        </RelativeLayout>
                    </LinearLayout>
                    <!--待审批订单和待处理订单-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:weightSum="2"
                        android:layout_weight="1"
                        android:layout_marginLeft="@dimen/x1"
                        >
                        <!--待审批订单-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:id="@+id/layout_shenpi_forwait"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/common_top_bar_blue"
                                android:textStyle="bold"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x10"
                                android:id="@+id/tv_shenpi_order"
                                android:text="21"
                                android:textSize="25sp"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="待审批订单"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x5"
                                android:layout_below="@+id/tv_shenpi_order"
                                />
                        </RelativeLayout>
                        <!--待处理-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginTop="@dimen/x1"
                            android:background="#fff"
                            android:id="@+id/layout_chuli_wait"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/common_top_bar_blue"
                                android:textStyle="bold"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x10"
                                android:id="@+id/tv_chuli_number"
                                android:text="21"
                                android:textSize="25sp"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="待处理"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x5"
                                android:layout_below="@+id/tv_chuli_number"
                                />
                        </RelativeLayout>
                    </LinearLayout>
                    <!--已支付订单和待审批-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:weightSum="2"
                        android:layout_weight="1"
                        android:layout_marginLeft="@dimen/x1"
                        >
                        <!--已支付订单-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:id="@+id/layout_yizhifu"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/common_top_bar_blue"
                                android:textStyle="bold"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x10"
                                android:id="@+id/tv_zhifu_number"
                                android:text="21"
                                android:textSize="25sp"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已支付订单"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x5"
                                android:layout_below="@+id/tv_zhifu_number"
                                />
                        </RelativeLayout>
                        <!--待审批-->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginTop="@dimen/x1"
                            android:background="#fff"
                            android:id="@+id/shenpi_layout"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/common_top_bar_blue"
                                android:textStyle="bold"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x10"
                                android:id="@+id/tv_shenpi2_number"
                                android:text="21"
                                android:textSize="25sp"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="待审批"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="@dimen/x5"
                                android:layout_below="@+id/tv_shenpi2_number"
                                />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
                <!--客户管理-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_marginBottom="@dimen/x10"
                        android:layout_marginLeft="@dimen/x10"
                        android:text="客户管理"
                        />
                </LinearLayout>
                <!--客户信息和新增客户-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x90"
                    android:orientation="horizontal"
                    android:weightSum="2"

                    >
                    <!--客户管理-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#fff"
                        >
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:src="@mipmap/home_page_true"
                            android:id="@+id/iv_kehu_manager"
                            />
                    </RelativeLayout>
                    <!--新增客户-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="@dimen/x1"
                        android:background="#fff"
                        >
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:src="@mipmap/home_page_true"
                            android:id="@+id/add_customer"
                            />
                    </RelativeLayout>
                </LinearLayout>
                <!--消息管理-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x10"
                        android:layout_marginBottom="@dimen/x10"
                        android:layout_marginLeft="@dimen/x10"
                        android:text="消息管理"
                        />
                </LinearLayout>
                <!--联系sumao，消息列表，消息通知-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x90"
                    android:orientation="horizontal"
                    android:weightSum="3"

                    >
                    <!--联系sumao-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#fff"
                        ></RelativeLayout>
                    <!--消息列表-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="@dimen/x1"
                        android:background="#fff"
                        ></RelativeLayout>
                    <!--消息通知-->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="@dimen/x1"
                        android:background="#fff"
                        ></RelativeLayout>
                </LinearLayout>

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

</FrameLayout>
