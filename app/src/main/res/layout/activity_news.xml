<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.pagerTwoMVP.PagerTwoView.NewsActivity">

     <include
         android:id="@+id/layout_title"
         layout="@layout/child_title_bar"></include>
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="@dimen/x100"
          android:id="@+id/layout_titleAndtime"
          android:layout_below="@+id/layout_title"
          android:background="@color/gray_type"
          >
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_Title"
              android:layout_centerHorizontal="true"
              android:textSize="18sp"
              android:layout_marginTop="@dimen/x20"
              />
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/tv_Title"
              android:id="@+id/layout_All"
              android:visibility="gone"
              android:layout_marginTop="@dimen/x10"
              android:layout_centerHorizontal="true"
              android:orientation="vertical"
              >
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  >
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_Time"
              android:layout_marginLeft="@dimen/x10"

              />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="浏览量:"
              android:id="@+id/tv_ab"
              android:layout_marginLeft="@dimen/x5"
              />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_num"

              />


          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="来源:"
              android:id="@+id/tv_ac"
              android:layout_marginLeft="@dimen/x5"
              />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_from"

              />


              </LinearLayout>
          </LinearLayout>


      </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/gray_type"
        android:id="@+id/layout"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_tishi"
            android:layout_marginTop="@dimen/x5"

            />
        <ImageView
            android:layout_width="@dimen/x20"
            android:layout_height="@dimen/x20"
            android:layout_below="@+id/tv_tishi"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/x5"
            android:id="@+id/iv_dianzan"
            android:src="@mipmap/dianzangray"
            android:visibility="gone"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_dianzan"
            android:layout_below="@+id/tv_tishi"
            android:layout_marginLeft="@dimen/x3"
            android:layout_toRightOf="@+id/iv_dianzan"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/x1"

            />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layout_titleAndtime"
        android:background="#fff"
        android:layout_above="@+id/layout"
        >
        <WebView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/wb_Content"
            />

    </RelativeLayout>

</RelativeLayout>
