<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.pagerTwoMVP.PagerTwoView.NewsActivity">

     <include
         android:id="@+id/layout_title"
         layout="@layout/child_title_bar"></include>
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="@dimen/x100"
          android:id="@+id/layout_titleAndtime"
          android:layout_below="@+id/layout_title"
          android:background="@color/gray_normal"
          >
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_Title"
              android:layout_centerHorizontal="true"
              android:textSize="18sp"
              android:layout_marginTop="@dimen/x20"
              />
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/tv_Title"
              android:id="@+id/layout_All"
              android:visibility="gone"
              android:layout_marginTop="@dimen/x20"
              android:layout_centerHorizontal="true"
              android:orientation="horizontal">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_Time"
              android:layout_marginLeft="@dimen/x10"

              />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="浏览量:"
              android:id="@+id/tv_ab"
              android:layout_marginLeft="@dimen/x10"
              />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_num"
              android:layout_marginLeft="@dimen/x3"
              />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="来源:"
              android:id="@+id/tv_ac"
              android:layout_marginLeft="@dimen/x10"
              />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:id="@+id/tv_from"
              android:layout_marginLeft="@dimen/x3"
              />
          </LinearLayout>
          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@id/tv_Title"
              android:id="@+id/layout_center"
              android:layout_marginTop="@dimen/x20"
              >
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:id="@+id/tv_Time2"
                  android:layout_marginTop="@dimen/x10"
                  android:layout_centerHorizontal="true"
                  />
          </RelativeLayout>

      </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layout_titleAndtime"
        android:background="#fff"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_Content"
            />
    </RelativeLayout>
</RelativeLayout>
