<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#fff"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:background="#29ABE2">

        <TextView
            android:id="@+id/tv_dialog_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="订单支付"
            android:textColor="#fff"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/iv_dialog_ok_cancel"
            android:layout_width="@dimen/x18"
            android:layout_height="@dimen/x18"
            android:visibility="invisible"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x10"
            android:src="@mipmap/erroy" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_ok_icon"
            android:layout_width="@dimen/x25"
            android:layout_height="@dimen/x25"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/x10"
            android:layout_marginTop="@dimen/x10"
            android:src="@mipmap/ok_icon" />

        <TextView
            android:id="@+id/tv_ok_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_ok_icon"
            android:layout_centerHorizontal="true"
            android:text="恭喜您支付成功"
            android:textColor="#8CC63F"
            android:textSize="14sp"

            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_ok_text"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/x10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_order_number_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#29ABE2"

                />

            <TextView
                android:id="@+id/pay_success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x5"
                android:text="支付成功"
                android:textColor="#8CC63F" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:layout_marginTop="@dimen/x10"
        android:background="#EEEEF3"></LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40"
        android:layout_marginBottom="@dimen/x10"
        android:layout_marginTop="@dimen/x10">

        <Button
            android:id="@+id/btn_ok_dialog"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x30"
            android:layout_centerHorizontal="true"
            android:background="@drawable/button_background_blue"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/selley_lv" />

        <LinearLayout
            android:id="@+id/linear_bottem_ok"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x30"
            android:layout_centerHorizontal="true">

            <Button
                android:id="@+id/bt_my_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_background_blue"
                android:text="订单详情"
                android:textColor="#fff"
                android:textSize="14sp"

                />

            <Button
                android:id="@+id/bt_wulliu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="@dimen/x30"
                android:layout_toRightOf="@+id/bt_my_order"
                android:background="@drawable/button_background_green"
                android:text="继续购物"
                android:textColor="#fff"
                android:textSize="14sp"
                android:visibility="gone"

                />
        </LinearLayout>
    </RelativeLayout>


</LinearLayout>

