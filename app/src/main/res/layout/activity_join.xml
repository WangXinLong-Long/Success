<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDF1"
    tools:context="com.silianchuangye.sumao.success.fragments.homepage.groupbuying.JoinActivity">

    <RelativeLayout
        android:id="@+id/layoutTop_auction"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:background="#fff">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/x20"
            android:layout_height="@dimen/x20"
            android:layout_marginLeft="@dimen/x10"
            android:layout_marginTop="@dimen/x10"
            android:src="@mipmap/my_sumao_back" />

        <TextView
            android:id="@+id/tvOpen_auction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/x10"
            android:text="我的参团记录"
            android:textColor="#000"
            android:textSize="18sp" />
        <!--Jobs Created 屏蔽掉购物车图表-->
        <!--<ImageView
            android:layout_width="@dimen/x25"
            android:layout_height="@dimen/x25"
            android:layout_marginTop="@dimen/x10"
            android:layout_marginLeft="@dimen/x10"
            android:src="@mipmap/gouwuche"
            android:id="@+id/gouwuche"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/x10"
            />-->

    </RelativeLayout>

    <LinearLayout

        android:id="@+id/layout_center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:layout_below="@+id/layoutTop_auction"
        android:weightSum="3">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="报价编号" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#dcdcdc"></LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="竞拍数量(吨)" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#dcdcdc"></LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="提交时间" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#dcdcdc"></LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#dcdcdc"></LinearLayout>

    <ListView
        android:id="@+id/lvDemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layout_Bottom"
        android:divider="#00000000"
        android:dividerHeight="0dip"></ListView>
</RelativeLayout>
