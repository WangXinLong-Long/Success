<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEF3"
    tools:context=".fragments.homepage.auction.AuctionMVP.view.AuctionActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x44"
        android:id="@+id/auction_layout_top"
        android:background="#28ABE3"
        >
        <ImageView
            android:id="@+id/ivBack_auction_layout_top"
            android:layout_width="@dimen/x60"
            android:layout_height="@dimen/x20"
            android:src="@drawable/back"
            android:layout_marginRight="@dimen/x20"
            android:paddingLeft="@dimen/x10"
            android:background="@drawable/fanhui"
            android:paddingRight="@dimen/x15"
            android:layout_centerVertical="true"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="竞拍"
            android:textColor="#fff"
            android:layout_centerHorizontal="true"
            android:textSize="18sp"
            android:layout_centerVertical="true"
            />
        <ImageView
            android:layout_width="@dimen/x15"
            android:layout_height="@dimen/y14"
            android:id="@+id/ivSearch_auction_layout_top"
            android:layout_marginTop="@dimen/y10"
            android:layout_alignParentRight="true"
            android:layout_marginRight="10dp"
            android:src="@drawable/search"
            android:visibility="gone"
            />
    </RelativeLayout>

    <com.jingchen.pulltorefresh.PullToRefreshLayout
        android:id="@+id/refresh_view"
        android:layout_below="@id/auction_layout_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <com.jingchen.pulltorefresh.PullableListView
            android:id="@+id/lvAuction_Auction_Layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#00000000"
            android:dividerHeight="0dip"
            android:background="#EEEEF3"
            android:layout_marginTop="@dimen/x5"
            ></com.jingchen.pulltorefresh.PullableListView>
    </com.jingchen.pulltorefresh.PullToRefreshLayout>
</RelativeLayout>
