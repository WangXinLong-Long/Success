<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relative_group_item"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/line1_create_logistics"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x10"
        android:background="@color/selley_bg" />

    <RelativeLayout
        android:id="@+id/relative_create_logistics_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x35"
        android:layout_below="@id/line1_create_logistics">

        <TextView
            android:id="@+id/tv_item_create_logistics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="订单编号 : "
            android:textColor="@color/black_deep"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_item_create_logistics_order_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/tv_item_create_logistics"
            android:textColor="@color/zixun_topbg"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/img_item_create_logistics_in"
            android:layout_width="@dimen/x20"
            android:layout_height="@dimen/x20"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x10"
            android:src="@mipmap/my_sumao_iv_order" />
    </RelativeLayout>

    <View
        android:id="@+id/line_create_logistics"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/relative_create_logistics_top"
        android:background="@color/my_sumao_background"></View>

    <LinearLayout
        android:id="@+id/linear_item_create_logistics_second"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x65"
        android:layout_below="@id/line_create_logistics"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/x30"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_item_create_logistics_order_people"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x10"
                android:text="下单人 : " />

            <TextView
                android:id="@+id/tv_item_create_logistics_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/tv_item_create_logistics_order_people"
                android:text="sdf" />

            <Button
                android:id="@+id/btn_item_create_logistics_kefu"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/x20"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/x10"
                android:background="@drawable/button_background_yellow"
                android:text="联系客服"
                android:textColor="@color/selley_lv" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_item_create_logistics_riqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x10"
                android:text="日期 : " />

            <TextView
                android:id="@+id/tv_item_create_logistic_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/tv_item_create_logistics_riqi" />

            <!--<TextView
                android:id="@+id/dun_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="吨"
                android:layout_marginRight="@dimen/x5"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />-->

            <TextView
                android:id="@+id/tv_item_create_logistic_vailable_quantity2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                 />

            <TextView
                android:id="@+id/tv_item_create_logistics_vailable_quantity1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@id/tv_item_create_logistic_vailable_quantity2"
                android:text="最大可发货数量(吨):" />


        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/company"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/x10"
                android:text="公司:" />

            <TextView
                android:id="@+id/tv_item_create_logistics_company_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/company"
                android:text="公司" />


        </RelativeLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:layout_below="@id/linear_item_create_logistics_second"
        android:background="@color/my_sumao_background" />
</RelativeLayout>