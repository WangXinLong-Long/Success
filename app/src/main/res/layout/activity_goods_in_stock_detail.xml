<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_sumao_background"
    android:id="@+id/layout_xianhuo"
    android:orientation="vertical">

    <include
        android:id="@+id/title_activity_goods_in_stock_detail"
        layout="@layout/title_bar_white"></include>

    <TextView
        android:id="@+id/spacing_activity_goods_in_stock_detail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x4"
        android:layout_below="@id/title_activity_goods_in_stock_detail"
        android:background="@color/my_sumao_background" />

    <ScrollView
        android:id="@+id/scroll_view_activity_goods_in_stock_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/spacing_activity_goods_in_stock_detail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x40"
                android:background="#fff"

                >

                <TextView
                    android:id="@+id/tvName_auction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x10"
                    android:layout_marginTop="@dimen/x10"
                    android:text=""
                    android:textColor="#111"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/layoutContent_auction"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="@dimen/x10"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivContent"
                        android:layout_width="@dimen/x20"
                        android:layout_height="@dimen/x20"
                        android:layout_marginTop="@dimen/x13"
                        android:src="@mipmap/service" />

                    <TextView
                        android:id="@+id/tvService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/x13"
                        android:text="联系卖家"
                        android:textColor="#5AA3D4"
                        android:textSize="15sp" />
                </LinearLayout>

            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/my_sumao_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginRight="@dimen/x5"
                android:background="@color/my_sumao_background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#fff"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x30"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/x10"
                        android:text="产品价格："
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvPrice_auction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#EE272F"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="元/吨"
                        android:textSize="13sp" />

                </LinearLayout>

               <!-- <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x30"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/integral_rule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/x10"
                        android:layout_marginTop="@dimen/x5"
                        android:text="积分规则:每吨商品积一分"
                        android:textSize="16sp" />
                </LinearLayout>-->
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginRight="@dimen/x5"
                android:background="@color/my_sumao_background" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:padding="@dimen/x5">

                <TextView
                    android:id="@+id/surplus_amount_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x5"
                    android:text="剩余数量:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/surplus_amount_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/surplus_amount_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />
                <TextView
                    android:id="@+id/dun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/surplus_amount_et"
                    android:text="吨"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/purchase_quantity_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/surplus_amount_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:text="起购量:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/purchase_quantity_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/surplus_amount_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/purchase_quantity_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/min_variable_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/purchase_quantity_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:text="最小变量单位:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/min_variable_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/purchase_quantity_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/min_variable_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/company_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/min_variable_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:text="公司:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/company_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/min_variable_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/company_tv"
                    android:ellipsize="end"
                    android:ems="20"
                    android:singleLine="true"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/delivery_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/company_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:text="交货时间:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/delivery_time_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/company_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/delivery_time_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/delivery_time_et_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/company_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/delivery_time_et"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/warehouse_address_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/delivery_time_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:text="仓库地址:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/warehouse_address_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/delivery_time_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/warehouse_address_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/delivery_mode_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/warehouse_address_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:text="交货方式:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/delivery_mode_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/warehouse_address_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/warehouse_address_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/classification_pre_sale_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_marginLeft="@dimen/x160"

                    android:text="分类:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/classification_pre_sale_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/classification_pre_sale_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/warehouse_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/classification_pre_sale_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_marginLeft="@dimen/x160"
                    android:text="仓库:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/warehouse_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/classification_pre_sale_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/warehouse_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/region_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/warehouse_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_marginLeft="@dimen/x160"
                    android:text="地区:"
                    android:textSize="@dimen/x10" />

                <TextView
                    android:id="@+id/region_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/warehouse_tv"
                    android:layout_marginBottom="@dimen/x5"
                    android:layout_toRightOf="@id/warehouse_tv"
                    android:text=""
                    android:textSize="@dimen/x10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x5"
                    android:layout_toRightOf="@id/delivery_mode_et"
                    android:layout_alignBottom="@id/delivery_mode_et"
                    android:text="*如需配送请在购买后填写物流计划,确定物流价格"
                    android:textColor="#FAB96D"
                    android:textSize="@dimen/x10" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/my_sumao_background" />
            <!--  <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="@dimen/x40"
                  android:orientation="horizontal"
                  android:background="#fff"
                  >


              </LinearLayout>-->
            <!-- <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="@dimen/x4"
                 android:background="@color/my_sumao_background"
                 ></LinearLayout>-->
            <LinearLayout
                android:id="@+id/remark_ll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x35"
                android:background="#fff"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x10"
                    android:layout_marginTop="@dimen/x7"
                    android:text="产品备注:"
                    android:textColor="#F9B05A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvRemark_auction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/x7"
                    android:text=""
                    android:textColor="#F9B05A"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/my_sumao_background"></LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x35"
                android:background="#fff">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/selley_lv"
                    android:focusable="true"
                    android:focusableInTouchMode="true">

                    <TextView
                        android:id="@+id/tv_item_cart_buy"
                        style="@style/tv_dingdan"
                        android:layout_marginLeft="@dimen/x10"
                        android:text="购买数量:" />

                    <TextView
                        android:id="@+id/img_item_cart_buy_sub"
                        android:layout_width="@dimen/x25"
                        android:layout_height="@dimen/x25"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/x10"
                        android:layout_toRightOf="@id/tv_item_cart_buy"
                        android:background="@drawable/cart_num"
                        android:gravity="center"
                        android:src="@mipmap/ic_launcher"
                        android:text="-"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/tv_item_cart_buy_num"
                        android:layout_width="@dimen/x50"
                        android:layout_height="@dimen/x25"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@id/img_item_cart_buy_sub"
                        android:background="@drawable/juxing"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                         />

                    <TextView
                        android:id="@+id/img_item_cart_buy_add"
                        android:layout_width="@dimen/x25"
                        android:layout_height="@dimen/x25"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@id/tv_item_cart_buy_num"
                        android:background="@drawable/cart_num"
                        android:gravity="center"
                        android:src="@mipmap/ic_launcher"
                        android:text="+"
                        android:textSize="20sp" />
                    <TextView
                        android:id="@+id/yuan"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="@dimen/x10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="元"/>
                    <TextView
                        android:id="@+id/tv_item_cart_all_price"
                        style="@style/tv_dingdan"
                        android:layout_toLeftOf="@id/yuan"
                        android:text="20"
                        android:textColor="#ff0000" />

                    <TextView
                        style="@style/tv_dingdan"
                        android:layout_toLeftOf="@id/tv_item_cart_all_price"
                        android:text="总价:" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x4"
                android:background="@color/my_sumao_background"></LinearLayout>

            <RelativeLayout
                android:id="@+id/pre_sale_sale_detail_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x7"
                    android:layout_marginLeft="@dimen/x5"
                    android:layout_marginTop="@dimen/x7"
                    android:text="合同详情、产品参数"
                    android:textSize="@dimen/x15" />

                <ImageView
                    android:layout_width="@dimen/x15"
                    android:layout_height="@dimen/x15"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/x5"
                    android:src="@mipmap/my_sumao_iv_order" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/pre_sale_sale_detail_similar_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x4"
                android:background="@color/white"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x7"
                    android:layout_marginLeft="@dimen/x5"
                    android:layout_marginTop="@dimen/x7"
                    android:text="相似产品"
                    android:textSize="@dimen/x15" />

                <ImageView
                    android:layout_width="@dimen/x15"
                    android:layout_height="@dimen/x15"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/x5"
                    android:src="@mipmap/my_sumao_iv_order" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/pre_sale_sale_detail_similar_liulan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x4"
                android:background="@color/white"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/x7"
                    android:layout_marginLeft="@dimen/x5"
                    android:layout_marginTop="@dimen/x7"
                    android:text="浏览记录"
                    android:textSize="@dimen/x15" />

                <ImageView
                    android:layout_width="@dimen/x15"
                    android:layout_height="@dimen/x15"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/x5"
                    android:src="@mipmap/my_sumao_iv_order" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x49"></LinearLayout>
        </LinearLayout>

    </ScrollView>

    <RelativeLayout
        android:id="@+id/Layout_Button_Open"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40"
        android:layout_alignParentBottom="true"

        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:id="@+id/layout_gongneng"
            android:orientation="horizontal"
            android:weightSum="2">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <Button
                    android:id="@+id/join_shopping_cart"
                    android:layout_width="match_parent"

                    android:layout_height="match_parent"
                    android:background="#29ABE2"
                    android:onClick="joincart"
                    android:text="加入购物车"
                    android:textColor="#fff"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <Button
                android:id="@+id/buy_immediately"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#0071BC"
                android:text="立即购买"
                android:textColor="#fff"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
        <Button
            android:layout_width="match_parent"
            android:layout_height="@dimen/x50"
            android:layout_alignParentBottom="true"
            android:background="@color/gray_normal"
            android:text="已闭市"
            android:visibility="gone"
            android:id="@+id/bt_Colse"
            ></Button>

    </RelativeLayout>

    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="20dp"
        android:src="@mipmap/shopping_cart"
        android:visibility="gone" />
</RelativeLayout>