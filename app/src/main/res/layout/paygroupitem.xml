<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"

    android:layout_height="wrap_content">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="@dimen/x3"
    android:background="@color/my_sumao_background"
    ></LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="@dimen/x5"
        android:paddingLeft="@dimen/x5"
        android:paddingTop="@dimen/x5">

        <TextView
            android:id="@+id/product_order_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="订单编号: 123456789"
            android:textColor="@color/btn_blue_normal"

            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginRight="@dimen/x5"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/my_sumao_background" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x60"
        android:background="@color/white">

        <TextView
            android:id="@+id/money_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x5"
            android:layout_marginTop="@dimen/x10"
            android:text="支付总金额：" />

        <TextView
            android:id="@+id/money_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5"
            android:layout_toRightOf="@id/money_tv"
            android:text="0"
            android:textColor="@color/red"
            android:textSize="@dimen/x20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/money_number"
            android:text="元"
            android:layout_marginTop="@dimen/x10"
            android:textColor="@color/red" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x40"
            android:id="@+id/bt_zhifu"
            android:text="立即支付"
            android:background="#0071BC"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/x20"
            android:layout_centerVertical="true"
            android:textColor="#fff"
            android:focusable="false"
            android:focusableInTouchMode="false"
            />
        <com.silianchuangye.sumao.success.fragments.homepage.goodInStock.goodsInStockDetail.GoodsInStockDetailActivityMVP.PayMentsOrderMVP.utils.TimeTextView
            android:textColor="@color/red"
            android:id="@+id/residual_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x5"
            android:layout_marginLeft="@dimen/x5"
            android:layout_marginTop="@dimen/x5"
            android:background="@color/white"
            android:layout_below="@+id/money_number"
            />
        <!--  <TextView
              android:textColor="@color/red"
              android:id="@+id/residual_time"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginBottom="@dimen/x5"
              android:layout_marginLeft="@dimen/x5"
              android:layout_marginTop="@dimen/x5"
              android:background="@color/white"
              android:layout_below="@+id/money_number"
              />-->
      </RelativeLayout>





  </LinearLayout>
