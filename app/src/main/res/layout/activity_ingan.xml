<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.accountmeneger.inganActivity">

    <include
        android:id="@+id/layout_title"
        layout="@layout/child_title_bar"></include>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/layout_bank"
        android:layout_below="@+id/layout_title"
        android:background="@color/gray_type"
        android:layout_marginTop="@dimen/x5"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#fff"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x3"
                android:layout_marginLeft="@dimen/x10"
                android:text="平安银行"
                android:textSize="20sp"

                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/gray_normal"
                android:layout_marginLeft="@dimen/x10"
                android:layout_marginRight="@dimen/x10"
                ></LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x50">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x30"
                    android:text="当前账户总余额"
                    android:textColor="@color/gray_normal"
                    android:id="@+id/monent"
                    android:layout_marginTop="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x30"
                    android:id="@+id/monent_value"
                    android:layout_below="@+id/monent"
                    />
                <LinearLayout
                    android:layout_width="@dimen/x1"
                    android:background="@color/gray_normal"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="@dimen/x10"
                    android:layout_marginBottom="@dimen/x10"
                    android:layout_height="match_parent">

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/x30"
                    android:text="当前账户可用余额"
                    android:textColor="@color/red"
                    android:id="@+id/monent_use"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/x30"
                    android:id="@+id/monent_use_value"
                    android:layout_below="@+id/monent_use"
                    android:layout_alignParentRight="true"
                    />

            </RelativeLayout>

        </LinearLayout>


    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/layout_bank_rig"
        android:layout_below="@+id/layout_title"
        android:visibility="gone"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/Iv_icon"
            android:src="@mipmap/pingan_rig"

            />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/bt_Rig"
            android:text="注册平安易宝"
            android:layout_below="@+id/Iv_icon"
            android:layout_marginTop="@dimen/x10"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/bt_Rig"
            android:textColor="@color/blue"
            android:autoLink="all"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/x10"
            android:text="提示:点击之前请务必点击查看《资金账户指南》"
            />



    </RelativeLayout>
</RelativeLayout>
