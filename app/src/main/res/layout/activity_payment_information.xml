<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EFEFF3"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.OrderManagement.SpotOrder.SpotOrderMVP.view.informationView.PaymentInformationActivity">
    <include
        android:id="@+id/payment_information_title"
        layout="@layout/child_title_bar" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x10"
                android:background="@color/white"
                android:padding="@dimen/x10">
                <TextView
                    android:id="@+id/margin_record_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="保证金记录"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/x10"
                    android:textColor="@color/btn_blue_normal"
                    />
                <TextView
                    android:id="@+id/margin_record_dividing_line"
                    android:background="@color/gray_type"
                    android:layout_width="match_parent"
                    android:layout_below="@id/margin_record_tv"
                    android:layout_height="@dimen/x1" />
                <com.silianchuangye.sumao.success.custom.CustomListView
                    android:id="@+id/margin_record_list_view"
                    android:layout_below="@id/margin_record_dividing_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/counter_fee_rl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x10"
                android:background="@color/white"
                android:padding="@dimen/x10">
                <TextView
                    android:id="@+id/counter_fee_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手续费"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/x10"
                    android:textColor="@color/btn_blue_normal"
                    />
                <TextView
                    android:layout_marginBottom="@dimen/x5"
                    android:id="@+id/counter_fee_dividing_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x1"
                    android:background="@color/gray_type"
                    android:layout_below="@id/counter_fee_tv"/>
                <TextView
                    android:text="已支付:"
                    android:id="@+id/counter_fee_has_paded_tv"
                    android:layout_marginBottom="@dimen/x10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/counter_fee_dividing_line"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/counter_fee_has_paded_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/counter_fee_dividing_line"
                    android:layout_toRightOf="@id/counter_fee_has_paded_tv"/>
                <TextView
                    android:text="元"
                    android:id="@+id/counter_fee_has_paded_yuan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/counter_fee_dividing_line"
                    android:layout_toRightOf="@id/counter_fee_has_paded_number"/>
                <TextView
                    android:text="日期:"
                    android:layout_marginBottom="@dimen/x10"
                    android:id="@+id/counter_fee_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/counter_fee_has_paded_tv"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/counter_fee_date_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/counter_fee_has_paded_tv"
                    android:layout_toRightOf="@id/counter_fee_date_tv"/>
                <TextView
                    android:text="时间:"
                    android:id="@+id/counter_fee_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_below="@id/counter_fee_has_paded_tv"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/counter_fee_time_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/counter_fee_has_paded_tv"
                    android:layout_toRightOf="@id/counter_fee_time_tv"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x10"
                android:background="@color/white"
                android:padding="@dimen/x10">
                <TextView
                    android:id="@+id/loan_record_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="货款记录"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/x10"
                    android:textColor="@color/btn_blue_normal"
                    />
                <TextView
                    android:layout_marginBottom="@dimen/x5"
                    android:id="@+id/loan_record_dividing_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x1"
                    android:background="@color/gray_type"
                    android:layout_below="@id/loan_record_tv"/>
                <TextView
                    android:text="已支付:"
                    android:id="@+id/frozen_tv"
                    android:layout_marginBottom="@dimen/x10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/loan_record_dividing_line"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/capital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/loan_record_dividing_line"
                    android:layout_toRightOf="@id/frozen_tv"/>
                <TextView
                    android:text="元"
                    android:id="@+id/capital_yuan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/loan_record_dividing_line"
                    android:layout_toRightOf="@id/capital"/>
                <TextView
                    android:text="日期:"
                    android:layout_marginBottom="@dimen/x10"
                    android:id="@+id/frozen_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/frozen_tv"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/frozen_date_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/frozen_tv"
                    android:layout_toRightOf="@id/frozen_date_tv"/>
                <TextView
                    android:text="时间:"
                    android:id="@+id/frozen_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_below="@id/frozen_tv"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/frozen_time_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/frozen_tv"
                    android:layout_toRightOf="@id/frozen_time_tv"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x10"
                android:background="@color/white"
                android:padding="@dimen/x10">
                <TextView
                    android:id="@+id/payment_information_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="付款信息"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/x10"
                    android:textColor="@color/btn_blue_normal"
                    />
                <TextView
                    android:layout_marginBottom="@dimen/x5"
                    android:id="@+id/payment_information_dividing_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x1"
                    android:background="@color/gray_type"
                    android:layout_below="@id/payment_information_tv"/>
                <TextView
                    android:text="付款方:"
                    android:id="@+id/payment_information_payer_tv"
                    android:layout_marginBottom="@dimen/x10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_dividing_line"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/payment_information_payer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_dividing_line"
                    android:layout_toRightOf="@id/payment_information_payer_tv"/>

                <TextView
                    android:text="付款银行:"
                    android:layout_marginBottom="@dimen/x10"
                    android:id="@+id/payment_information_paying_bank_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_payer_tv"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/payment_information_paying_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_payer_tv"
                    android:layout_toRightOf="@id/payment_information_paying_bank_tv"/>
                <TextView
                    android:text="付款账号:"
                    android:id="@+id/payment_information_payment_account_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_below="@id/payment_information_payer_tv"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/payment_information_payment_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_payer_tv"
                    android:layout_toRightOf="@id/payment_information_payment_account_tv"/>

                <TextView
                    android:layout_marginBottom="@dimen/x5"
                    android:id="@+id/payment_information_dividing_line2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/x1"
                    android:background="@color/gray_type"
                    android:layout_below="@id/payment_information_paying_bank_tv"/>
                <TextView
                    android:text="收款方:"
                    android:id="@+id/payment_information_payer_tv2"
                    android:layout_marginBottom="@dimen/x10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_dividing_line2"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/payment_information_payer2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_dividing_line2"
                    android:layout_toRightOf="@id/payment_information_payer_tv2"/>

                <TextView
                    android:text="收款银行:"
                    android:layout_marginBottom="@dimen/x10"
                    android:id="@+id/payment_information_paying_bank_tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_payer_tv2"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/payment_information_paying_bank2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_payer_tv2"
                    android:layout_toRightOf="@id/payment_information_paying_bank_tv2"/>
                <TextView
                    android:text="收款账号:"
                    android:id="@+id/payment_information_payment_account_tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_below="@id/payment_information_payer_tv2"/>
                <TextView
                    android:text="~~"
                    android:id="@+id/payment_information_payment_account2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/payment_information_payer_tv2"
                    android:layout_toRightOf="@id/payment_information_payment_account_tv2"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
