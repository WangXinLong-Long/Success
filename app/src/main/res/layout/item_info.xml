<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x40">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/red"
        android:layout_centerVertical="true"

        android:id="@+id/tv_Xing"
        android:layout_marginLeft="@dimen/x10"
        />

    <TextView
        android:id="@+id/tv_lv_dayplan_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/tv_Xing"
        android:layout_marginLeft="@dimen/x3"
        android:text="计划日期"
        />
    <ImageView
        android:id="@+id/img_lv_dayplan_date"
        android:layout_width="@dimen/x17"
        android:layout_height="@dimen/x17"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/x10"
        android:layout_centerVertical="true"
        android:src="@mipmap/my_sumao_iv_order"/>
    <TextView
        android:id="@+id/tv_lv_dayplan_date_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:text="sfd"
        android:maxEms="16"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_toLeftOf="@id/img_lv_dayplan_date"/>

</RelativeLayout>
