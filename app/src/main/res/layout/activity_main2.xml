<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.seller.Main2Activity">
   <RelativeLayout
       android:layout_width="match_parent"
       android:layout_alignParentBottom="true"
       android:id="@+id/layout_info"
       android:layout_height="@dimen/x44">
       <View
           android:layout_width="match_parent"
           android:layout_height="@dimen/x3"
           android:background="#efefef"
           ></View>
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="@dimen/x50"
           android:orientation="horizontal"
           android:weightSum="5"
           android:layout_centerVertical="true"
           android:background="#F2F2F2"
           >
           <ImageView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@mipmap/home_page_true"
               android:layout_weight="1"
               android:id="@+id/iv_one"
               />
           <View
               android:layout_width="@dimen/x1"
               android:layout_height="match_parent"
               android:background="#efefef"></View>
           <ImageView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@mipmap/home_page_true"
               android:layout_weight="1"
               android:id="@+id/iv_two"
               />
           <View
               android:layout_width="@dimen/x1"
               android:layout_height="match_parent"
               android:background="#efefef"></View>
           <ImageView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@mipmap/home_page_true"
               android:layout_weight="1"
               android:id="@+id/iv_three"
               />
           <View
               android:layout_width="@dimen/x1"
               android:layout_height="match_parent"
               android:background="#efefef"></View>
           <ImageView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@mipmap/home_page_true"
               android:layout_weight="1"
               android:id="@+id/iv_four"
               />
           <View
               android:layout_width="@dimen/x1"
               android:layout_height="match_parent"
               android:background="#efefef"></View>
           <ImageView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@mipmap/home_page_true"
               android:layout_weight="1"
               android:id="@+id/iv_five"
               />
       </LinearLayout>
   </RelativeLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_info"
        android:id="@+id/fragLayout"
        ></FrameLayout>
</RelativeLayout>
