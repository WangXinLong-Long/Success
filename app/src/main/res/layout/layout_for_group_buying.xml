<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="#fff"
    android:descendantFocusability="blocksDescendants"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40">
        <ImageView
            android:layout_width="@dimen/x30"
            android:layout_height="@dimen/y25"
            android:id="@+id/iv_auction_icon"

            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_auction_name"
            android:textSize="16sp"
            android:text="燕山石化"
            android:layout_marginLeft="@dimen/x35"
            android:layout_marginTop="@dimen/x10"
            android:textStyle="bold"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_auction_time"
            android:layout_marginTop="@dimen/x13"
            android:textSize="14sp"
            android:text=""

            android:textColor="#29ABE2"
            android:layout_marginRight="@dimen/x20"
            android:layout_alignParentRight="true"
            />
       <!-- <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始时间:"
            android:layout_toLeftOf="@+id/tv_auction_time"
            android:layout_marginTop="@dimen/x13"
            android:layout_marginLeft="@dimen/x5"
            android:textColor="#29ABE2"
            android:id="@+id/tv_auction_start"

            />-->
        <ImageView
            android:layout_width="@dimen/x70"
            android:layout_height="@dimen/x30"
            android:id="@+id/iv_auction_end"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginRight="@dimen/x10"
            />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:background="#d3d3d3"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        ></RelativeLayout>
    <RelativeLayout
        android:id="@+id/a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_auction_startPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x30"
            android:layout_marginTop="@dimen/x10"
            android:text="团购价格:"

            />
        <!--团购单价-->
        <TextView
            android:id="@+id/tv_auction_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x10"
            android:layout_toRightOf="@+id/tv_auction_startPrice"
            android:text="~~"
            android:textColor="#EE2B33" />

        <TextView
            android:id="@+id/tv_auction_priceicon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x10"
            android:layout_toRightOf="@id/tv_auction_price"
            android:text="元/吨" />


        <TextView
            android:id="@+id/auction_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_auction_startPrice"
            android:layout_marginLeft="@dimen/x30"
            android:layout_marginTop="@dimen/x5"
            android:text="团购总量:" />
        <!--团购总量-->
        <TextView
            android:id="@+id/tv_auction_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_auction_startPrice"
            android:layout_marginTop="@dimen/x5"
            android:layout_toRightOf="@id/auction_number" />

        <TextView
            android:id="@+id/tv_auction_ton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_auction_startPrice"
            android:layout_marginTop="@dimen/x5"
            android:layout_toRightOf="@+id/tv_auction_number"
            android:text="吨" />

        <Button
            android:layout_width="@dimen/x80"
            android:layout_height="@dimen/x35"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/x10"
            android:layout_marginRight="@dimen/x20"
            android:text="参与团购"
            android:textColor="#fff"
            android:id="@+id/bt_auctionitem"

            />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:background="#d3d3d3"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:layout_marginTop="@dimen/x3"
        ></RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/a"
        android:layout_marginTop="@dimen/x5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_auction_group"
            android:text="成团量:"
            android:layout_marginLeft="@dimen/x20"
            android:textSize="12sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_group_number"
            android:text="50t"
            android:layout_marginLeft="@dimen/x5"
            android:textSize="12sp"
            android:layout_toRightOf="@+id/tv_auction_group"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv__group_way"
            android:text="交货方式:"
            android:layout_marginLeft="@dimen/x50"
            android:textSize="12sp"
            android:layout_toRightOf="@+id/tv_group_number"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_group_way_value"
            android:text="50t"
            android:layout_marginLeft="@dimen/x5"
            android:textSize="12sp"
            android:layout_toRightOf="@+id/tv__group_way"
            />



    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/a"
        android:layout_marginTop="@dimen/x5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_auction_werhouse"
            android:text="仓库:"
            android:layout_marginLeft="@dimen/x20"
            android:textSize="12sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_auction_acdress"
            android:text="北京迅邦1号库"
            android:layout_marginLeft="@dimen/x5"
            android:textSize="12sp"
            android:layout_toRightOf="@+id/tv_auction_werhouse"
            />

    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x3"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_auction_comm"
            android:textSize="12sp"
            android:text="公司:"
            android:layout_marginLeft="@dimen/x20"

            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_auction_commAdress"
            android:textSize="12sp"
            android:text="东莞市住友塑料有限公司"
            android:layout_toRightOf="@+id/tv_auction_comm"
            android:layout_marginLeft="@dimen/x3"

            />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:background="#d3d3d3"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:layout_marginTop="@dimen/x3"
        ></RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40"
        >
        <RelativeLayout
            android:id="@+id/start_data_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5">

            <TextView
                android:id="@+id/start_data_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x20"
                android:text="开始时间:"
                android:textColor="@color/btn_register_pressed"
                android:textStyle="bold"
                android:textSize="12sp" />
            <!--开始时间-->
            <TextView
                android:id="@+id/start_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x5"
                android:layout_toRightOf="@+id/start_data_tv"
                android:text="~~"
                android:textStyle="bold"
                android:textColor="@color/btn_register_pressed"
                android:textSize="12sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/end_data_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/start_data_rl"
            android:layout_marginTop="@dimen/x3">

            <TextView
                android:id="@+id/end_data_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x20"
                android:text="结束时间："
                android:textStyle="bold"
                android:textColor="@color/orange"
                android:textSize="12sp" />
            <!--结束时间-->
            <TextView
                android:id="@+id/end_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/end_data_tv"
                android:text="~~"
                android:textColor="@color/orange"
                android:textStyle="bold"
                android:textSize="12sp"

                />
        </RelativeLayout>
        <TextView
            android:visibility="gone"
            android:id="@+id/tv_final_num"
            android:text="最终成团量"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x10"
            android:layout_alignParentRight="true"
            android:textColor="@color/orange"

            />
    </RelativeLayout>

    <LinearLayout
        android:layout_marginTop="@dimen/x5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x5"
        android:background="#EEEEF3"></LinearLayout>
</LinearLayout>