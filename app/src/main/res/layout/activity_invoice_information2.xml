<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.OrderManagement.SpotOrder.SpotOrderMVP.view.informationView.InvoiceInformationActivity">
    <include
        android:id="@+id/invoice_information_title"
        layout="@layout/child_title_bar" />
    <RelativeLayout
        android:padding="@dimen/x10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_below="@id/invoice_information_title">
        <RelativeLayout
            android:id="@+id/billing_status_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x10">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开票状态"
                />
            <TextView
                android:id="@+id/billing_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="~~"
                />
        </RelativeLayout>

        <TextView
            android:id="@+id/dividing_line1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:background="@color/gray_type"
            android:layout_below="@id/billing_status_rl"
            android:layout_marginBottom="@dimen/x10"
            />
        <RelativeLayout
            android:id="@+id/bill_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dividing_line1"
            android:layout_marginBottom="@dimen/x10">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="票据"
                />
            <ImageView
                android:id="@+id/bill_detial"
                android:layout_width="@dimen/x15"
                android:layout_height="@dimen/x15"
                android:layout_alignParentRight="true"
                android:src="@mipmap/my_sumao_iv_order"/>
            <TextView
                android:id="@+id/bill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/x2"
                android:layout_toLeftOf="@id/bill_detial"
                android:text="~~"
                />
        </RelativeLayout>
        <TextView
            android:id="@+id/dividing_line2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:background="@color/gray_type"
            android:layout_below="@id/bill_rl"
            android:layout_marginBottom="@dimen/x10"
            />
        <RelativeLayout
            android:id="@+id/courier_number_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dividing_line2"
            android:layout_marginBottom="@dimen/x10">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快递单号"
                />

            <TextView
                android:id="@+id/courier_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="~~"
                />
        </RelativeLayout>
        <TextView
            android:id="@+id/dividing_line3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:background="@color/gray_type"
            android:layout_below="@id/courier_number_rl"
            android:layout_marginBottom="@dimen/x10"
            />
        <RelativeLayout
            android:id="@+id/express_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dividing_line3"
            android:layout_marginBottom="@dimen/x10">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快递公司"
                />

            <TextView
                android:id="@+id/express"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="~~"
                />
        </RelativeLayout>
        <TextView
            android:id="@+id/dividing_line4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:background="@color/gray_type"
            android:layout_below="@id/express_rl"
            android:layout_marginBottom="@dimen/x10"
            />
        <RelativeLayout
            android:id="@+id/remark_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dividing_line4"
            android:layout_marginBottom="@dimen/x10">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备注"
                />

            <TextView
                android:id="@+id/remark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="~~"
                />
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>
