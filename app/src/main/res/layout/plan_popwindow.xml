<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/all"
    android:background="#fff"
    >

    <RelativeLayout
        android:id="@+id/relative_create_logistics_top"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginTop="0dp"

        android:background="@color/zixun_topbg">

        <ImageView
            android:id="@+id/img_create_logistics_back1"
            android:layout_width="@dimen/x60"
            android:layout_height="@dimen/x20"
            android:src="@mipmap/back"
            android:layout_marginRight="@dimen/x20"
            android:paddingLeft="@dimen/x10"
            android:background="@drawable/fanhui"
            android:paddingRight="@dimen/x15"
            android:layout_centerVertical="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="采购计划"
            android:textColor="@color/selley_lv"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_create_logistics_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x10"
            android:text="取消"
            android:textColor="@color/selley_lv" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_pop_customer_two"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:layout_below="@id/relative_create_logistics_top"
        android:layout_marginTop="@dimen/x7">

        <EditText
            android:id="@+id/tv_pop_customer_num"
            android:layout_width="@dimen/x240"
            android:layout_height="@dimen/x30"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x7"
            android:background="@drawable/juxing"
            android:gravity="center_vertical"
            android:textColor="#222"
            android:paddingLeft="@dimen/x7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/tv_pop_customer_num"
            android:text="产品名称 : "

            android:id="@+id/name"
            android:textColor="#222"
            />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/demand_date"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:layout_below="@id/relative_pop_customer_two"
        android:layout_marginTop="@dimen/x7">

        <TextView
            android:id="@+id/tv_pop_customer_Shi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x7" />

        <LinearLayout
            android:id="@+id/linear_shi"
            android:layout_width="@dimen/x115"
            android:layout_height="@dimen/x30"
            android:layout_toLeftOf="@id/tv_pop_customer_Shi"
            android:background="@drawable/juxing"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/demand_end_time"
                android:layout_width="@dimen/x83"
                android:layout_height="@dimen/x30"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:textColor="#222"
                android:paddingLeft="@dimen/x5" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@mipmap/drop_down" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/linear_shi"
            android:textColor="#222"
            android:text="至" />

        <LinearLayout
            android:id="@+id/linear_sheng"
            android:layout_width="@dimen/x110"
            android:layout_height="@dimen/x30"
            android:layout_toLeftOf="@id/sheng"
            android:background="@drawable/juxing"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/demand_start_time"
                android:layout_width="@dimen/x78"
                android:layout_height="@dimen/x30"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:textColor="#222"
                android:paddingLeft="@dimen/x5" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/drop_down" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/linear_sheng"
            android:id="@+id/Time"
            android:textColor="#222"
            android:text="计划日期:" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/mention_state"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:layout_below="@id/demand_date"
        android:layout_marginTop="@dimen/x7">

        <LinearLayout
            android:id="@+id/mention_state_ll"
            android:layout_width="@dimen/x110"
            android:layout_height="@dimen/x30"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/x135"
            android:background="@drawable/juxing"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_pop_customer_qu"
                android:layout_width="@dimen/x80"
                android:layout_height="@dimen/x30"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:textColor="#222"
                android:paddingLeft="@dimen/x3" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/drop_down" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/mention_state_ll"
            android:id="@+id/state"
            android:textColor="#222"
            android:text="提报状态:" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_pop_customer_five"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:layout_below="@id/mention_state"
        android:layout_marginTop="@dimen/x7">

        <EditText
            android:id="@+id/tv_pop_customer_name"
            android:layout_width="@dimen/x240"
            android:layout_height="@dimen/x30"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x7"
            android:background="@drawable/juxing"
            android:textColor="#222"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:id="@+id/cangku"
            android:textColor="#222"
            android:layout_toLeftOf="@id/tv_pop_customer_name"
            android:text="仓库名称:" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relative_pop_customer_six"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:layout_below="@id/relative_pop_customer_five"
        android:layout_marginTop="@dimen/x7">

        <LinearLayout
            android:id="@+id/linear2"
            android:layout_width="@dimen/x240"
            android:layout_height="@dimen/x30"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/x7"
            android:background="@drawable/juxing"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_pop_customer_zhuangtai"
                android:layout_width="@dimen/x210"
                android:layout_height="@dimen/x30"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:textColor="#222"
                android:paddingLeft="@dimen/x7" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/drop_down" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@id/linear2"
            android:id="@+id/way"
            android:textColor="#222"
            android:text="配送方式:" />
    </RelativeLayout>

    <View
        android:id="@+id/line_pop_customer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/relative_pop_customer_six"
        android:layout_marginBottom="@dimen/x3"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/selley_bg" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/line_pop_customer">

        <Button
            android:id="@+id/btn_pop_customer_search"
            android:layout_width="@dimen/x145"
            android:layout_height="@dimen/x35"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/x7"
            android:layout_marginTop="@dimen/x3"
            android:background="@drawable/button_background_blue"
            android:text="立即查询"
            android:textColor="@color/selley_lv" />
    </RelativeLayout>

    <ListView
        android:id="@+id/lv_sheng"
        android:layout_width="@dimen/x110"
        android:layout_height="wrap_content"
        android:layout_below="@id/demand_date"
        android:layout_marginLeft="@dimen/x75"
        android:background="@drawable/juxing"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_shi"
        android:layout_width="@dimen/x110"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_below="@id/demand_date"
        android:layout_marginRight="@dimen/x10"
        android:background="@drawable/juxing"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_qu"
        android:layout_width="@dimen/x110"
        android:layout_height="wrap_content"
        android:layout_below="@id/mention_state"
        android:layout_marginLeft="@dimen/x75"
        android:layout_marginRight="@dimen/x7"
        android:background="@drawable/juxing"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_zhuangtai"
        android:layout_width="@dimen/x240"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_below="@id/relative_pop_customer_six"
        android:layout_marginRight="@dimen/x7"
        android:background="@drawable/juxing"
        android:visibility="gone" />

</RelativeLayout>
