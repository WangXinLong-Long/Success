<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.accountmeneger.open.KunlunOpenActivity">

    <include
        android:id="@+id/kunlunOpen_layout"
        layout="@layout/child_title_bar"></include>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x10"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:background="#fff"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginRight="@dimen/x5"
            android:layout_marginLeft="@dimen/x5"
            android:text="确定企业已有昆仑银行一般结算账户,并且网银生效(通常在开户3个工作日以后自动生效)"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:text="点击下载《昆仑银行开户及签约指南》"
            android:textColor="@color/textColor_expandable_listview_show"
            android:layout_marginRight="@dimen/x5"
            android:id="@+id/tvqianyuezhinan"
            android:layout_marginBottom="@dimen/x5"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x10"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:background="#fff"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x5"
            android:layout_marginRight="@dimen/x5"
            android:layout_marginLeft="@dimen/x5"
            android:text="确定企业已下载'委托收付款承诺函',已打印、签字盖章,并已邮寄至昆仑银行,并且已寄出7天以上"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:text="点击下载《委托收付款承诺函》"
            android:textColor="@color/textColor_expandable_listview_show"
            android:layout_marginRight="@dimen/x5"
            android:layout_marginBottom="@dimen/x5"
            android:id="@+id/tvChengnuohan"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x10"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:background="#fff"
        >
        <ListView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/lvDemo"
            ></ListView>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#efefef"
        >
    <Button
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x44"
        android:background="@color/textColor_expandable_listview_show"
        android:text="签约"
        android:textColor="#fff"
        android:textSize="20sp"
        android:id="@+id/btqianyue"
        android:layout_marginRight="@dimen/x5"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginBottom="@dimen/x5"
        ></Button>
    </RelativeLayout>

</LinearLayout>
