<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="#fff"
    android:layout_height="@dimen/x280">

    <include
        android:id="@+id/search_text"
        layout="@layout/child_title_bar"></include>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/x280">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/region_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:text="地区" />
            <com.silianchuangye.sumao.success.custom.CustomGridView
                android:id="@+id/region_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="3dp"
                android:numColumns="5"
                android:layout_marginRight="@dimen/x5"
                android:layout_marginLeft="@dimen/x5"
                android:padding="@dimen/x5"
                android:verticalSpacing="3dp" />
            <TextView
                android:id="@+id/classification_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:text="分类" />
            <com.silianchuangye.sumao.success.custom.CustomGridView
                android:id="@+id/classification_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="3dp"
                android:numColumns="5"
                android:padding="@dimen/x5"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginRight="@dimen/x5"
                android:verticalSpacing="3dp" />
            <TextView
                android:id="@+id/application_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:text="应用" />
            <com.silianchuangye.sumao.success.custom.CustomGridView
                android:id="@+id/application_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="3dp"
                android:numColumns="5"
                android:layout_marginRight="@dimen/x5"
                android:layout_marginLeft="@dimen/x5"
                android:padding="@dimen/x5"
                android:verticalSpacing="3dp" />
            <TextView
                android:id="@+id/shengchanshang_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:paddingLeft="@dimen/x10"
                android:paddingBottom="@dimen/x5"
                android:paddingTop="@dimen/x5"
                android:text="生产商" />
            <com.silianchuangye.sumao.success.custom.CustomGridView
                android:id="@+id/shangchanshang_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="3dp"
                android:numColumns="4"
                android:layout_marginLeft="@dimen/x5"
                android:layout_marginRight="@dimen/x5"
                android:padding="@dimen/x5"
                android:verticalSpacing="3dp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="@dimen/x25"
                android:background="@drawable/juxing"
                android:id="@+id/et_productName"
                android:hint="请输入产品名称查询"
                android:layout_marginLeft="@dimen/x10"
                android:layout_marginRight="@dimen/x10"
                android:textColorHint="@color/gray_normal"
                android:textColor="#222"
                />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="@dimen/x25"
                android:background="@drawable/juxing"
                android:id="@+id/et_warehouseName"
                android:hint="请输入仓库名称查询"
                android:textColor="#222"
                android:layout_marginTop="@dimen/x5"
                android:layout_marginLeft="@dimen/x10"
                android:layout_marginRight="@dimen/x10"
                android:textColorHint="@color/gray_normal"
                />

            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="@dimen/x50"

                >

                <Button
                    android:id="@+id/reset"
                    android:layout_width="@dimen/x50"
                    android:layout_height="@dimen/x25"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/x10"
                    android:background="@drawable/button_background_yellow"
                    android:text="重置" />

                <Button
                    android:id="@+id/completed"
                    android:layout_width="@dimen/x50"
                    android:layout_height="@dimen/x25"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/x10"
                    android:background="@drawable/button_backgroup_save"
                    android:text="确定" />
            </RelativeLayout>


        </LinearLayout>

    </ScrollView>



</LinearLayout>
