<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.accountmeneger.KunlunActivity">
    <include
        android:id="@+id/layout_title"
        layout="@layout/child_title_bar"></include>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/layout_bank"
        android:layout_below="@+id/layout_title"
        android:background="@color/gray_type"
        android:layout_marginTop="@dimen/x5"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#fff"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x3"
                android:layout_marginLeft="@dimen/x10"
                android:text="昆仑银行"
                android:textSize="20sp"

                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:background="@color/gray_normal"
                android:layout_marginLeft="@dimen/x10"
                android:layout_marginRight="@dimen/x10"
                ></LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/x50">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x30"
                    android:text="当前账户总余额"
                    android:textColor="@color/gray_normal"
                    android:id="@+id/monent"
                    android:layout_marginTop="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/x30"
                    android:id="@+id/monent_value"
                    android:layout_below="@+id/monent"
                    />
                <LinearLayout
                    android:layout_width="@dimen/x1"
                    android:background="@color/gray_normal"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="@dimen/x10"
                    android:layout_marginBottom="@dimen/x10"
                    android:layout_height="match_parent">

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/x30"
                    android:text="当前账户可用余额"
                    android:textColor="@color/red"
                    android:id="@+id/monent_use"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/x5"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/x30"
                    android:id="@+id/monent_use_value"
                    android:layout_below="@+id/monent_use"
                    android:layout_alignParentRight="true"
                    />

            </RelativeLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/x40"
            android:weightSum="2"
            android:layout_alignParentBottom="true"
            >
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="账号变更"
                android:textColor="#fff"
                android:textStyle="bold"
                android:background="@color/btn_register_normal"
                android:id="@+id/bt_Update"
                />
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="账号解约"
                android:textColor="#fff"
                android:textStyle="bold"
                android:background="@color/orange"
                android:id="@+id/bt_Open"
                />

        </LinearLayout>


    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/layout_bank_rig"
        android:layout_below="@+id/layout_title"
        android:visibility="gone"
        >
        <ListView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#fff"
            android:id="@+id/lv_Info"
            android:layout_marginTop="@dimen/x5"
            ></ListView>
        
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background_blue"
            android:textSize="16sp"
            android:text="确认签约"
            android:layout_below="@+id/lv_Info"
            android:id="@+id/bt_Qianyue"
            android:layout_marginTop="@dimen/x10"
            />



    </RelativeLayout>
</RelativeLayout>
