<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/selley_bg">

    <RelativeLayout
        android:id="@+id/rl_informatin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x43"
        android:layout_marginBottom="@dimen/x5"
        android:background="#fff">

        <TextView
            android:id="@+id/information"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingBottom="@dimen/x5"
            android:paddingTop="@dimen/x5"
            android:text="资讯"
            android:textSize="18sp" />

        <ImageView
            android:visibility="invisible"
            android:id="@+id/calendar_view"
            android:layout_width="@dimen/x30"
            android:layout_height="@dimen/x30"
            android:src="@mipmap/calendar"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/x8"
            />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40"
        android:layout_below="@id/rl_informatin"
        android:background="#fff"
        android:layout_marginBottom="@dimen/x5">

        <android.support.design.widget.TabLayout
            app:tabTextAppearance="@style/MyTabLayoutTextAppearance"
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            app:tabIndicatorColor="#28ABE3"
            app:tabSelectedTextColor="#28ABE3" />
    </RelativeLayout>


    <android.support.v4.view.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_tab_layout" />
</RelativeLayout>
