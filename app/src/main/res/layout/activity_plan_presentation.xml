<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.myPlasticTrade.demandPlanning.PlanPresentationMVP.view.PlanPresentationActivity">
    <LinearLayout
        android:id="@+id/linear_day_plan"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">
        >

        <Button
            android:id="@+id/btn_day_plan_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/greenjuxing"
            android:gravity="center"
            android:text="添加计划"
            android:textColor="@color/selley_lv" />

        <Button
            android:id="@+id/btn_day_plan_tijiao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/chinanorth"
            android:gravity="center"
            android:text="立即提交"
            android:textColor="@color/selley_lv" />
    </LinearLayout>

    <ExpandableListView
        android:id="@+id/lv_day_plan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/linear_day_plan"
        android:layout_marginTop="@dimen/x10">

    </ExpandableListView>

</RelativeLayout>
