<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.silianchuangye.sumao.success.fragments.myPlasticTrade.PhysicalDistributionManagement.logistics.Logistics">
<include layout="@layout/child_title_bar"
    android:id="@+id/title"/>
    <RelativeLayout
        android:id="@+id/create_logistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_marginTop="@dimen/x2"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/x10"
            android:text="创建物流需求" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/view_logistics_demand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/create_logistics"
        android:layout_marginTop="@dimen/x1"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/x10"
            android:text="查看物流需求" />
    </RelativeLayout>

</RelativeLayout>
