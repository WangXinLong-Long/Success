<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/title_height"
    android:background="@color/textColor_expandable_listview_show"
    android:paddingBottom="@dimen/padding_right"
    android:paddingTop="@dimen/padding_right">

    <ImageView
        android:id="@+id/iv_child_title_bar_back"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/x20"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/x20"
        android:paddingLeft="@dimen/x10"
        android:paddingRight="@dimen/x15"
        android:background="@drawable/fanhui"
        android:src="@mipmap/back" />

    <TextView
        android:id="@+id/tv_child_title_bar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text=""
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_child_title_bar_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/x10"
        android:text=""
        android:textColor="@color/white"
        android:textSize="15sp" />
</RelativeLayout>