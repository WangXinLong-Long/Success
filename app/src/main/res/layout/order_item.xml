<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <!--  <TextView
          android:layout_width="match_parent"
          android:layout_height="@dimen/x5"
          android:background="@color/my_sumao_background"
          />-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x5"
        android:background="@color/gray_type"/>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x5"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginTop="@dimen/x5"
        android:textColor="#000"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:background="@color/gray_type" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="@dimen/x5"
        android:paddingLeft="@dimen/x5"
        android:paddingTop="@dimen/x5">

        <TextView
            android:id="@+id/product_order_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="订单编号: 123456789"
            android:textColor="@color/btn_blue_normal"

            />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginRight="@dimen/x5"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/my_sumao_background" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x30"
        android:background="@color/white">

        <TextView
            android:id="@+id/money_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="@dimen/x5"
            android:text="支付总金额：" />

        <TextView
            android:id="@+id/money_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/x5"
            android:layout_toRightOf="@id/money_tv"
            android:text="0"
            android:textColor="@color/red"
            android:textSize="@dimen/x20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_toRightOf="@id/money_number"
            android:text="元"
            android:textColor="@color/red" />
    </RelativeLayout>

    <TextView
        android:textColor="@color/red"
        android:id="@+id/residual_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/x5"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/white"
        android:text="~~"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:layout_marginLeft="@dimen/x5"
        android:layout_marginRight="@dimen/x5"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/my_sumao_background" />

    <RelativeLayout
        android:id="@+id/product_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="@dimen/x5">

        <TextView
            android:id="@+id/surplus_amount_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x5"
            android:text="分类："
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/surplus_amount_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/surplus_amount_tv"
            android:text=""
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/purchase_quantity_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/surplus_amount_tv"
            android:layout_marginBottom="@dimen/x5"
            android:text="产品牌号："
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/purchase_quantity_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/surplus_amount_tv"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/purchase_quantity_tv"
            android:text=""
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/min_variable_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/purchase_quantity_tv"
            android:layout_marginBottom="@dimen/x5"
            android:text="生产企业："
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/min_variable_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/purchase_quantity_tv"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/min_variable_tv"
            android:text=""
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/delivery_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/min_variable_tv"
            android:layout_marginBottom="@dimen/x5"
            android:text="仓库："
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/delivery_time_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/min_variable_tv"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/delivery_time_tv"
            android:text="北京讯邦1库"
            android:textSize="@dimen/x10" />


        <TextView
            android:id="@+id/classification_pre_sale_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x5"
            android:layout_marginLeft="@dimen/x160"
            android:text="价格(元/吨)："
            android:textSize="@dimen/x10"

            />

        <TextView
            android:id="@+id/classification_pre_sale_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/classification_pre_sale_tv"
            android:text="6100"
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/warehouse_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@id/classification_pre_sale_tv"
            android:layout_below="@id/classification_pre_sale_tv"
            android:layout_marginBottom="@dimen/x5"
            android:text="数量(吨)："
            android:textSize="@dimen/x10" />
        <!--android:layout_toRightOf="@id/delivery_time_et"
            android:layout_marginLeft="@dimen/x35"-->
        <TextView
            android:id="@+id/warehouse_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/classification_pre_sale_tv"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/warehouse_tv"
            android:text="~~"
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/region_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@id/classification_pre_sale_tv"
            android:layout_below="@id/warehouse_tv"
            android:layout_marginBottom="@dimen/x5"
            android:text="产品总价（元）："
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/region_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/warehouse_tv"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/region_tv"
            android:text=""
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/company_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@id/classification_pre_sale_tv"
            android:layout_below="@id/region_tv"
            android:layout_marginBottom="@dimen/x5"
            android:text="公司："
            android:textSize="@dimen/x10" />

        <TextView
            android:id="@+id/company_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/region_tv"
            android:layout_marginBottom="@dimen/x5"
            android:layout_toRightOf="@id/company_tv"
            android:text=""
            android:textSize="@dimen/x10" />

    </RelativeLayout>
    <Button
        android:id="@+id/pay_button"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40"
        android:background="#0071BC"
        android:text="立即支付"
        android:textColor="#fff"
        android:textSize="16sp"
        android:textStyle="bold"/>
</LinearLayout>
