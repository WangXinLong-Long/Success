<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_sumao_background"
    tools:context=".fragments.myPlasticTrade.login.forgetPassword.phonePassword.view.PhonePasswordActivity">

    <include
        android:id="@+id/title"
        layout="@layout/child_title_bar" />

    <RelativeLayout
        android:id="@+id/telephone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_marginTop="@dimen/x5"
        android:background="@color/white"
        android:padding="@dimen/x5">

        <TextView
            android:id="@+id/telephone_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="手机号"
            android:textSize="@dimen/x15" />

        <TextView
            android:id="@+id/bt_get_register"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x30"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/x10"
            android:background="@drawable/button_background_blue"
            android:gravity="center"
            android:text="获取验证码"
            android:textColor="#fff" />

        <EditText
            android:id="@+id/telephone_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:layout_toRightOf="@id/telephone_tv"
            android:background="@null"
            android:hint="请输入手机号"
            android:singleLine="true"
            android:inputType="phone"
            android:textSize="@dimen/x10" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/split_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x2"
        android:layout_below="@id/telephone"
        android:background="@color/my_sumao_background"
        android:orientation="vertical" />

    <RelativeLayout
        android:id="@+id/verification_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/split_line"
        android:background="@color/white"
        android:padding="@dimen/x10">

        <TextView
            android:id="@+id/phone_verification_code_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x5"
            android:text="手机验证码"
            android:textSize="@dimen/x15" />

        <EditText
            android:id="@+id/verification_code_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:layout_toRightOf="@id/phone_verification_code_tv"
            android:background="@null"
            android:hint="请输入手机验证码"
            android:inputType="number"
            android:singleLine="true"
            android:textSize="@dimen/x10" />

    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x40"
        android:layout_below="@id/verification_code"
        android:layout_marginTop="@dimen/x10"
        android:id="@+id/layout_yanzheng"
        android:background="#fff"
        >
        <TextView
            android:id="@+id/verification_code_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:text="验证码"
            android:textSize="@dimen/x15" />
        <EditText
            android:id="@+id/checkout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/x10"
            android:layout_toRightOf="@id/verification_code_tv"
            android:background="@null"
            android:hint="请输入验证码"
            android:singleLine="true"
            android:textSize="@dimen/x10"/>


        <TextView
            android:id="@+id/change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/x10"
            android:layout_centerVertical="true"
            android:textColor="@color/btn_register_pressed"
            android:text="换一张" />

        <ImageView
            android:id="@+id/iv_verification_code"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_toLeftOf="@id/change"
            android:layout_toRightOf="@id/checkout"
            android:layout_centerVertical="true"
             />

    </RelativeLayout>

    <Button
        android:id="@+id/submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_yanzheng"
        android:layout_marginLeft="@dimen/x10"
        android:layout_marginRight="@dimen/x10"
        android:layout_marginTop="@dimen/x20"
        android:background="@drawable/button_background_blue"
        android:text="立即提交 "
        android:textColor="#fff" />
</RelativeLayout>
