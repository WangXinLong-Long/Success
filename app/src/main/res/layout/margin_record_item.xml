<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:layout_marginTop="@dimen/x10"
        android:text="冻结:"
        android:id="@+id/frozen_tv"
        android:layout_marginBottom="@dimen/x10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:layout_marginTop="@dimen/x10"
        android:text="~~"
        android:id="@+id/capital"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/frozen_tv"/>
    <TextView
        android:layout_marginTop="@dimen/x10"
        android:text="元"
        android:id="@+id/capital_yuan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/capital"/>
    <TextView
        android:text="日期:"
        android:layout_marginBottom="@dimen/x10"
        android:id="@+id/frozen_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/frozen_tv"/>
    <TextView
        android:text="~~"
        android:id="@+id/frozen_date_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/frozen_tv"
        android:layout_toRightOf="@id/frozen_date_tv"/>
    <TextView
        android:text="时间:"
        android:id="@+id/frozen_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_below="@id/frozen_tv"/>
    <TextView
        android:text="~~"
        android:id="@+id/frozen_time_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/frozen_tv"
        android:layout_toRightOf="@id/frozen_time_tv"/>
</RelativeLayout>