<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#fff"
    android:layout_height="match_parent"

    tools:context=".fragments.myPlasticTrade.demandPlanning.planType.TypeActivity">
    <include
        android:id="@+id/layoutTop_firm_info_type"
        layout="@layout/child_title_bar"></include>
    <Button
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/x10"
        android:layout_marginLeft="@dimen/x10"
        android:background="@drawable/button_background_blue"
        android:textColor="#fff"
        android:textSize="16sp"
        android:layout_marginTop="@dimen/x5"
        android:text="保存"
        android:id="@+id/bt_upload"
        android:layout_marginBottom="@dimen/x10"

        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fff"
        android:layout_marginTop="@dimen/x5"
        android:orientation="vertical"
        android:layout_below="@+id/layoutTop_firm_info_type"
        android:id="@+id/layout_info"
        android:layout_above="@+id/bt_upload"
        >

    <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/lv_Firm_Type"
        ></ListView>




    </LinearLayout>
</RelativeLayout>
